{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vallum Desktop",
  "version": "1.8.0",
  "identifier": "com.ikaros.vallum",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vallum",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://ipc.localhost; script-src 'self' tauri: 'unsafe-inline' 'unsafe-eval'; style-src 'self' tauri: 'unsafe-inline'; img-src 'self' data: tauri:; connect-src ipc: http://ipc.localhost tauri: http://127.0.0.1:9999; frame-ancestors 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "shortDescription": "Operations cockpit for the Vallum post-quantum VPN",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../../packaging/vallum-gui.desktop"
      },
      "rpm": {
        "desktopTemplate": "../../packaging/vallum-gui.desktop"
      }
    }
  }
}
