# Alertmanager for the Vallum single-operator host — TEMPLATE.
# Copy to /etc/prometheus/alertmanager.yml and replace <NTFY_TOPIC> with an
# unguessable topic (openssl rand -hex 8). Do NOT commit the real topic: anyone
# who knows it can read or publish alerts. Subscribe on your phone at
# https://ntfy.sh/<NTFY_TOPIC> (ntfy app, or `ntfy subscribe <NTFY_TOPIC>`).
#
# vmalert reaches this at -notifier.url=http://127.0.0.1:9093 (see
# contrib/ops/vmalert-notifier.conf). ntfy parses the Alertmanager webhook
# payload at its /alertmanager endpoint — no bridge daemon needed.
global:
  resolve_timeout: 5m
route:
  receiver: ntfy
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h
receivers:
  - name: ntfy
    webhook_configs:
      - url: 'https://ntfy.sh/<NTFY_TOPIC>/alertmanager'
        send_resolved: true
    # Second channel (premortem 2026-11-19, modes 4/6): email alongside ntfy, so an
    # ntfy.sh outage or a silenced phone does not blind the operator. Uncomment and
    # fill the SMTP placeholders to enable; the same alerts then reach both channels.
    # The SMTP password is a secret — keep this file 0600, never commit the real one.
    # email_configs:
    #   - to: '<OPERATOR_EMAIL>'
    #     from: '<ALERT_FROM_EMAIL>'
    #     smarthost: '<SMTP_HOST:587>'
    #     auth_username: '<SMTP_USER>'
    #     auth_password: '<SMTP_PASSWORD>'
    #     send_resolved: true
