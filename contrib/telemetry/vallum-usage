#!/usr/bin/env python3
"""Human-readable Vallum traffic, read from VictoriaMetrics.

Counters are cumulative since the daemon started, so a restart resets them to
zero. That is fine for a live view; for a total across restarts use
`increase(...)` over a window, which the rate columns already do.
"""
import json
import sys
import urllib.parse
import urllib.request

VM = "http://127.0.0.1:8428/api/v1/query"


def query(expr):
    url = VM + "?" + urllib.parse.urlencode({"query": expr})
    try:
        with urllib.request.urlopen(url, timeout=10) as response:
            return json.load(response)["data"]["result"]
    except Exception:
        return []


def scalar(expr):
    rows = query(expr)
    return float(rows[0]["value"][1]) if rows else 0.0


def human(value):
    value = float(value)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(value) < 1024 or unit == "TiB":
            return f"{int(value)} B" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1024
    return f"{value:.1f} TiB"


def main():
    down = scalar("sum(vallum_peer_rx_bytes_total)")
    up = scalar("sum(vallum_peer_tx_bytes_total)")
    if down == 0 and up == 0 and not query("vallum_up"):
        print("no telemetry yet — is vallum-telemetry.timer running?")
        return 1

    print("Vallum traffic through this server")
    print(f"  down    {human(down)}")
    print(f"  up      {human(up)}")
    print(f"  total   {human(down + up)}")
    print(
        "  now     down {}/s, up {}/s".format(
            human(scalar("sum(rate(vallum_peer_rx_bytes_total[5m]))")),
            human(scalar("sum(rate(vallum_peer_tx_bytes_total[5m]))")),
        )
    )

    peers = {}
    for metric in ("vallum_peer_rx_bytes_total", "vallum_peer_tx_bytes_total"):
        for row in query(f"sum by (peer) ({metric})"):
            name = row["metric"].get("peer", "?")
            peers.setdefault(name, {})[
                "down" if metric.endswith("rx_bytes_total") else "up"
            ] = float(row["value"][1])

    if peers:
        print()
        print(f"  {'peer':<20} {'down':>10} {'up':>10}  last handshake")
        for name, values in sorted(peers.items()):
            age = query(f'vallum_peer_handshake_age_seconds{{peer="{name}"}}')
            age_text = f"{int(float(age[0]['value'][1]))}s ago" if age else "-"
            print(
                f"  {name:<20} {human(values.get('down', 0)):>10} "
                f"{human(values.get('up', 0)):>10}  {age_text}"
            )
    return 0


if __name__ == "__main__":
    sys.exit(main())
