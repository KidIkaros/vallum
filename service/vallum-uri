#!/usr/bin/env python3
"""vallum-uri — the x-scheme-handler target for vallum:// URIs.

A browser-opened `vallum://join?ticket=…&account=…[&desk=…]` arrives here
as argv[1]. The URI is validated byte-strictly, then enrolment runs through
the privileged dispatcher when passwordless sudo grants it:

    sudo -n vallum-ops join   (ticket/token/desk on stdin lines 1/2/3, #32)

As root, `vallum join` installs the service and proves the tunnel, so the
single-use ticket buys a working tunnel — not a user config and a burned
ticket with zero packets. Without the dispatcher it falls back to a same-uid
`vallum join -` (ticket on stdin, VALLUM_ACCOUNT / VALLUM_DESK_ENDPOINT in the
environment, ADR-0046) and says how to bring the tunnel up.

Nothing secret ever sits on a command line — argv is world-readable in ps;
stdin and a same-uid environment are not. Nothing is shell-evaluated: the URI
is parsed, not executed. A browser-triggered URI only ever reaches root
through the named, audited `vallum-ops join` verb, never a wildcard.

Usage: vallum-uri 'vallum://join?ticket=<urlencoded>&account=<hex>[&desk=<origin>]'
       vallum-uri 'vallum://account?token=<hex>[&desk=<origin>]'

vallum://account (ADR-0047 Q4) records the account number client-side so
`vallum account` can manage it without re-pasting the shown-once number; it
enrols no device. The token rides the URI fired by script, keeping it out of
browser history and prefetchers, the same pattern as the join Connect link.
"""

import os
import re
import subprocess
import sys
import urllib.parse

# The `vallum1-join:` grammar, byte-strict (enroll.rs JoinTicket::parse):
#   <host>:<port>/<name>/<32-hex invite id>/<32-hex token>/<even hex fp>
TICKET = re.compile(
    r"vallum1-join:[^\s/:]+:\d{1,5}"      # host:port
    r"/[A-Za-z0-9._-]{1,32}"              # name
    r"/[0-9a-fA-F]{32}"                   # invite id
    r"/(?:[0-9a-fA-F]{32}|[0-9a-fA-F]{4}(?:-[0-9a-fA-F]{4}){7})"  # token, bare or dashed
    r"/(?:[0-9a-fA-F]{2}){4,}$")          # fingerprint, >=8 hex chars
ACCOUNT = re.compile(r"[0-9a-f]{32}$")    # the desk's token_hex(16)
# The desk origin (ADR-0046): https + host[:port], nothing else — no userinfo,
# path, query or fragment. The endpoint is where the account token will be
# sent, so a malformed origin is a refusal, not a shrug.
DESK = re.compile(r"https://[A-Za-z0-9.-]+(?::\d{1,5})?")


def parse_uri(uri):
    """The URI's ticket, account token and desk origin, or a refusal.
    Strictness here is the boundary between 'a browser asked' and 'a browser
    got root to run vallum': the shape is all that is trusted, and it is
    checked fully. `desk` is None for a URI without the param (older desks)."""
    parsed = urllib.parse.urlparse(uri)
    if parsed.scheme != "vallum":
        raise ValueError("not a vallum:// URI")
    if parsed.netloc not in ("join", "") and parsed.path not in ("join", "/join"):
        raise ValueError("unknown action — only vallum://join is served")
    fields = urllib.parse.parse_qs(parsed.query, keep_blank_values=True)
    ticket = fields.get("ticket", [""])[0]
    account = fields.get("account", [""])[0]
    desk = fields.get("desk", [""])[0]
    if not TICKET.fullmatch(ticket):
        raise ValueError("the ticket is not a vallum1-join: ticket")
    if not ACCOUNT.fullmatch(account):
        raise ValueError("the account number is 32 hex characters")
    if desk and not DESK.fullmatch(desk):
        raise ValueError("the desk origin is not an https://host[:port] origin")
    return ticket, account, desk or None


def parse_account_uri(uri):
    """vallum://account?token=<32hex>[&desk=<origin>] — the account-number
    handoff (ADR-0047 Q4). No ticket: this records the account client-side;
    enrolment is a separate join. Strict shape, same boundary as join."""
    parsed = urllib.parse.urlparse(uri)
    if parsed.scheme != "vallum":
        raise ValueError("not a vallum:// URI")
    fields = urllib.parse.parse_qs(parsed.query, keep_blank_values=True)
    token = fields.get("token", [""])[0]
    desk = fields.get("desk", [""])[0]
    if not ACCOUNT.fullmatch(token):
        raise ValueError("the account number is 32 hex characters")
    if desk and not DESK.fullmatch(desk):
        raise ValueError("the desk origin is not an https://host[:port] origin")
    return token, desk or None


def _account_config_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.path.expanduser("~"), ".config")
    return os.path.join(base, "vallum", "account.toml")


def _record_account(token, desk):
    """Write the account number client-side (ADR-0047 Q4) so `vallum account`
    can manage it without re-pasting the shown-once number. A minimal config:
    [account] is what the read uses; the [interface] stub satisfies the parser
    and is never run — this handoff enrols no device. 0600: bearer credential."""
    path = _account_config_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    lines = ["# Vallum account, recorded from the desk's open-in-client link.",
             "# Account-only: no device is enrolled here; add one from the desk.",
             "[interface]",
             'private_key = "account.key"',
             "",
             "[account]",
             f'token = "{token}"']
    if desk:
        lines.append(f'endpoint = "{desk}"')
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")
    return path


def _privileged_join_available():
    """True when passwordless sudo grants the audited dispatcher — the same
    trust boundary the TUI/GUI join uses. Probing `sudo -n -l` avoids running
    the join twice (a failed privileged join must not fall through to a second
    attempt that spends the ticket again)."""
    try:
        probe = subprocess.run(
            ["sudo", "-n", "-l", "/usr/local/sbin/vallum-ops"],
            capture_output=True, text=True)
    except FileNotFoundError:
        return False
    return probe.returncode == 0


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) != 1:
        print("usage: vallum-uri 'vallum://join?...' | 'vallum://account?token=...'",
              file=sys.stderr)
        return 2
    action = urllib.parse.urlparse(argv[0]).netloc or \
        urllib.parse.urlparse(argv[0]).path.lstrip("/")
    if action == "account":
        try:
            token, desk = parse_account_uri(argv[0])
        except ValueError as error:
            print(f"vallum-uri: refused — {error}", file=sys.stderr)
            return 2
        path = _record_account(token, desk)
        print(f"vallum-uri: recorded your account at {path}")
        print(f"Manage it with: vallum account --config {path}")
        return 0
    try:
        ticket, account, desk = parse_uri(argv[0])
    except ValueError as error:
        print(f"vallum-uri: refused — {error}", file=sys.stderr)
        return 2
    # Prefer the privileged dispatcher: as root, `vallum join` installs the
    # service and proves the tunnel, so the single-use ticket buys a working
    # tunnel. The ticket/token/desk ride stdin (sudo strips env; #32), never
    # argv. This is the primary alpha enrolment path (ADR-0044/0046).
    if _privileged_join_available():
        stdin = ticket + "\n" + account + ("\n" + desk if desk else "") + "\n"
        result = subprocess.run(
            ["sudo", "-n", "/usr/local/sbin/vallum-ops", "join"],
            input=stdin, text=True)
        return result.returncode
    # No dispatcher: a same-uid join writes a user config. Say how to bring the
    # tunnel up so this is a guided step, not a silent no-op with a spent ticket.
    env = dict(os.environ, VALLUM_ACCOUNT=account)
    # The endpoint comes from the URI or not at all: an inherited value would
    # point a desk-less enrolment at whatever desk the caller last used.
    env.pop("VALLUM_DESK_ENDPOINT", None)
    if desk:
        env["VALLUM_DESK_ENDPOINT"] = desk
    result = subprocess.run(
        ["vallum", "join", "-"], input=ticket, env=env, text=True)
    if result.returncode == 0:
        print("vallum-uri: wrote a user config (no privileged dispatcher). "
              "Bring the tunnel up with `sudo vallum run --config <the path "
              "printed above>`, or install the dispatcher so Connect enrols "
              "as a service.", file=sys.stderr)
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
