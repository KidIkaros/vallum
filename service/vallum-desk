        '<label>invite code<br><input name="code" required></label><br><br>')
    intro = ("A device name gets you a join ticket; your key never leaves "
             "your machine." if open_signup else
             "An invite code gets you a join ticket; your key never leaves "
             "your machine.")
    return f"""<!doctype html><title>vallum desk</title>
<style>body{{font:16px/1.6 system-ui;max-width:36em;margin:10vh auto;padding:0 1em}}
input,button{{font:inherit;padding:.4em .6em}}button{{cursor:pointer}}
pre{{white-space:pre-wrap;word-break:break-all;padding:1em;border:1px solid #888}}</style>
