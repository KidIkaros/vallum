def make_handler(desk):
    """The HTTP adapter. It translates requests into desk calls and nothing
    else: no account rule lives here."""

    class Handler(BaseHTTPRequestHandler):
        def _send(self, code, payload):
            body = json.dumps(payload).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            # Every JSON answer here carries a ticket, a token or account data;
            # health carries neither but must not be answered from a cache by a
            # front that would go on saying "ok" after the daemon died.
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def _body(self):
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                raise BodyTooLarge("a non-numeric Content-Length")
            if length > MAX_BODY:
                raise BodyTooLarge(f"body over {MAX_BODY} bytes")
            raw = self.rfile.read(length) or b""
            if "application/x-www-form-urlencoded" in (self.headers.get("Content-Type") or ""):
                from urllib.parse import parse_qs
                fields = {k: v[0] for k, v in parse_qs(raw.decode(), keep_blank_values=True).items()}
                # curl's `-d` sends form-encoding by default: a JSON body that
                # arrives this way parses as one key with an empty value and
                # then fails with a misleading "bad admin token". Say what it is.
                if len(fields) == 1 and next(iter(fields)).lstrip().startswith("{"):
                    raise ValueError("this looks like a JSON body sent as a form — "
                                     "send it with Content-Type: application/json")
                return fields
            try:
                parsed = json.loads(raw or "{}")
            except json.JSONDecodeError:
                return {}
            # Only a dict body is a request — a JSON list or scalar would
            # crash the first .get() downstream.
            return parsed if isinstance(parsed, dict) else {}

        def _client_ip(self):
            """The visitor, not the proxy.

            The desk binds loopback and is fronted by Caddy in the documented
            deployment, so every direct peer is the proxy. The rightmost
            X-Forwarded-For hop is the address that proxy saw; a client cannot
            forge it, because the proxy appends its own observation. A direct
            loopback caller could spoof the header, but that caller is already
            inside the operator's trust boundary.
            """
            direct = self.client_address[0]
            forwarded = self.headers.get("X-Forwarded-For")
            if forwarded and direct in ("127.0.0.1", "::1"):
                hop = forwarded.split(",")[-1].strip()
                if hop:
                    return hop
            return direct

        def _desk_origin(self):
            """This desk's public origin: https + the Host header. Caddy (the
            documented front) forwards Host, so the URI tells the client which
            desk its account lives on (ADR-0046). No Host, no desk param —
            never a guess."""
            host = self.headers.get("Host")
            return f"https://{host}" if host else None

        def _send_html(self, body, status=200, private=False):
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            if private:
                # Bearer-authed pages must not be cached or crawled.
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Robots-Tag", "noindex")
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body.encode())

        def _send_js(self, body=DESK_JS):
            self.send_response(200)
            self.send_header("Content-Type", "text/javascript; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body.encode())

        def do_HEAD(self):
            # Monitors and link checkers HEAD; 501 read as "the site is
            # down" when the pages were fine. Same routes, headers only.
            self.do_GET()

        def do_GET(self):
            if self.path == "/healthz":
                # No credential, no account data: the one route a front or a
                # probe can ask, and the answer that separates "listening"
                # from "working".
                code, payload = desk.health()
                self._send(code, payload)
                return
            if self.path == "/":
                active, queued, _ = desk.seat_state()
                self._send_html(index_page(desk.config.open_signup, desk.config.operator_name,
                                           desk.config.install_source, desk.config.repo_url,
                                           desk.config.contact,
                                           capacity=(active,
                                                     desk.config.max_active_accounts,
                                                     queued)))
                return
            if self.path == "/desk.js":
                # Public static content — no credentials — so fronts may
                # cache it; the pages reference it under script-src 'self'.
                self._send_js()
                return
            if self.path == "/account":
                self._send_html(account_shell_page(desk.config.operator_name, desk.config.contact))
                return
            if self.path.startswith("/api/status"):
                # The token used to ride this URL — into proxy access logs.
                # It travels POST bodies now; refuse the old shape.
                self._send(410, {"error": "the token no longer travels the URL — "
                                          "POST it in the body: POST /api/status "
                                          '{"token": "..."}'})
                return
            self._send(404, {"error": "no such endpoint"})

        def do_POST(self):
            try:
                try:
                    body = self._body()
                except BodyTooLarge as error:
                    self._send(413, {"error": str(error)})
                    return
                if self.path == "/api/signup":
                    code, payload = desk.signup(body, self._client_ip())
                elif self.path == "/signup":
                    # The no-script path: a plain form post, answered with a
                    # page. Agents keep /api/signup and its JSON.
                    code, payload = desk.signup(body, self._client_ip())
                    if code == 200:
                        self._send_html(account_created_page(payload, desk.config.operator_name,
                                                             desk.config.install_source, desk.config.repo_url,
                                                             desk_origin=self._desk_origin()),
                                        private=True)
                    else:
                        self._send_html(error_page(payload.get("error", ""), desk.config.operator_name, desk.config.contact),
                                        status=code)
                    return
                elif self.path == "/api/devices":
                    code, payload = desk.add_device(body, self._desk_origin())
                elif self.path == "/api/devices/revoke":
                    code, payload = desk.remove_device(body)
                elif self.path == "/api/devices/rotate":
                    code, payload = desk.rotate_device(body)
                elif self.path == "/api/voucher":
                    code, payload = desk.voucher(body)
                elif self.path == "/api/status":
                    code, payload = desk.status(body.get("token") or "")
                elif self.path == "/api/account":
                    code, payload = desk.account(body.get("token") or "")
                elif self.path == "/account":
                    # The account page, no-script: the token arrives in the
                    # form body, never the URL.
                    code, view = desk.account(body.get("token") or "")
                    if code == 200:
                        self._send_html(account_page(view, body["token"], operator=desk.config.operator_name), private=True)
                    else:
                        self._send_html(error_page(view.get("error", ""), desk.config.operator_name, desk.config.contact,
                                                   heading="Could not open the account"),
                                        status=code, private=True)
                    return
                elif self.path == "/account/device":
                    code, payload = desk.add_device(body, self._desk_origin())
                    if code == 200:
                        # The page needs the token for its manage-account
                        # form; the caller sent it, so this is no new echo.
                        payload["token"] = body.get("token")
                        self._send_html(ticket_page(payload, desk.config.operator_name,
                                                    desk.config.install_source, desk.config.repo_url),
                                        private=True)
                    else:
                        self._send_html(error_page(payload.get("error", ""), desk.config.operator_name, desk.config.contact,
                                                   heading="Could not add the device"),
                                        status=code, private=True)
                    return
                elif self.path == "/account/revoke":
                    if body.get("confirm") != "yes":
                        # A bare click must not withdraw a device: the
                        # forcing function names the cost on a second,
                        # explicit step (no-script, like every page here).
                        view_code, view = desk.account(body.get("token") or "")
                        if view_code != 200:
                            self._send_html(error_page(view.get("error", ""), desk.config.operator_name, desk.config.contact,
                                                       heading="Could not open the account"),
                                            status=view_code, private=True)
                        else:
                            self._send_html(revoke_confirm_page(view, body.get("peer", ""),
                                                                body.get("token", ""), desk.config.operator_name),
                                            private=True)
                        return
                    code, payload = desk.remove_device(body)
                    notice = (f"removed {payload['removed']}" if code == 200
                              else payload.get("error", "remove failed"))
                    view_code, view = desk.account(body.get("token") or "")
                    if view_code != 200:
                        self._send_html(error_page(view.get("error", ""), desk.config.operator_name, desk.config.contact,
                                                   heading="Could not open the account"),
                                        status=view_code, private=True)
                    else:
                        self._send_html(account_page(view, body.get("token", ""), notice, desk.config.operator_name),
                                        status=code, private=True)
                    return
                elif self.path == "/account/voucher":
                    code, payload = desk.voucher(body)
                    notice = (f"code applied — plan {payload['plan']}, "
                              f"until {payload['expires']}" if code == 200
                              else payload.get("error", "code refused"))
                    view_code, view = desk.account(body.get("token") or "")
                    if view_code != 200:
                        self._send_html(error_page(view.get("error", ""), desk.config.operator_name, desk.config.contact,
                                                   heading="Could not open the account"),
                                        status=view_code, private=True)
                    else:
                        self._send_html(account_page(view, body.get("token", ""), notice, desk.config.operator_name),
                                        status=code, private=True)
                    return
                elif self.path.startswith("/api/admin/"):
                    code, payload = desk.admin(self.path, body)
                else:
                    code, payload = 404, {"error": "no such endpoint"}
            except Exception as error:  # noqa: BLE001 - a service must answer
                # A service must answer, not drop the connection: the client
                # cannot tell a refusal from a crash.
                print(f"desk: request failed: {error!r}")
                code, payload = 500, {"error": f"internal error: {error}"}
            self._send(code, payload)

        def log_message(self, fmt, *args):
            print(f"desk: {self.address_string()} {fmt % args}")

    return Handler


