    """Where the account number goes. The token is a credential: it enters
    by POST body or not at all — never the URL."""
    return f"""<!doctype html><title>{_esc(operator)} — account</title>{ACCOUNT_STYLE}
<p><small>{_esc(operator)}</small></p>
