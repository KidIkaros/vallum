def _esc(text):
    return (str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


INSTALL_BLURB = """<p><b>Don't have the client yet?</b>
<pre>curl -fsSL -o /tmp/vallum-install.sh \\
  https://raw.githubusercontent.com/KidIkaros/vallum/main/scripts/install.sh
sudo bash /tmp/vallum-install.sh --from-release --install-only</pre>
Linux + systemd; the release signature verifies itself before anything is
installed. Source and docs: <a href="https://github.com/KidIkaros/vallum">github.com/KidIkaros/vallum</a>.</p>"""


