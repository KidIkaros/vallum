# The white-label defaults: the upstream project's own install source and
# repo. An operator deploying their own service overrides both — the flags
# ride VALLUM_DESK_EXTRA_ARGS in /etc/vallum/desk.env like every other knob —
# and nothing the desk serves then points at the upstream repo. Unset, the
# desk renders exactly what it always did.
DEFAULT_INSTALL_SOURCE = ("https://raw.githubusercontent.com/KidIkaros/vallum/"
                          "main/scripts/install.sh")
DEFAULT_REPO_URL = "https://github.com/KidIkaros/vallum"


@dataclass
class DeskConfig:
    """Everything the desk needs to run, in one place."""

    state: str
    codes: str
    admin_token: str
    trial_days: int
    trial_bytes: int
    sweep_secs: int
    config: str
    bind: str
    port: int
    cli: str = "vallum"
    # On-demand access: signup without an invite code, bounded on every axis
    # an anonymous visitor can push on. The peer table is a /24 — a ceiling,
    # not a formality — so capacity, not politeness, is what stops a crawl.
    open_signup: bool = False
    open_trial_bytes: int = 5 * 1024 * 1024 * 1024   # 5 GiB anonymous trial
    max_active_accounts: int = 200                   # the /24 holds 253
    signup_ip_day_limit: int = 3                     # signups per IP per day
    device_cap: int = 5                              # devices per account
    reservation_ttl: int = 1200                      # seconds a minted ticket reserves a slot (> the 15-min invite, so a slow join is not released mid-flight)
    operator_name: str = "vallum desk"               # the page header's brand
    install_source: str = DEFAULT_INSTALL_SOURCE     # the install.sh URL served to users
    repo_url: str = DEFAULT_REPO_URL                 # the source/docs link served to users


# ---------------------------------------------------------------- the desk

class Desk:
    """The account lifecycle: signups, plans, enforcement, revocation."""

    def __init__(self, config: DeskConfig, daemon: Daemon):
        self.config = config
        self.daemon = daemon
        self.db = open_database(config.state)
        # Reentrant: helpers hold it for their own statements, and a caller
        # may already hold it when calling them — every self.db access runs
        # under it, since one sqlite3.Connection is not concurrent-safe.
        self.lock = threading.RLock()

    # -- inputs ---------------------------------------------------------

    def file_codes(self):
        """Invite codes from the operator's file, re-read per request so a code
        can be added without restarting the desk."""
        path = self.config.codes
        if not path or not os.path.exists(path):
            return set()
        try:
            with open(path) as f:
                return {line.strip() for line in f if line.strip() and not line.startswith("#")}
        except OSError as error:
            print(f"desk: cannot read the codes file {path}: {error}")
            return set()

    def domain_of(self, url):
        return re.sub(r"^[a-z]+://", "", url.split("/")[0]).split(":")[0].lower()

    # -- the peers relation ----------------------------------------------

    def _peers_of(self, account):
        """The account's device peer names. The peers table is the relation;
        the legacy `accounts.peer` column is the fallback for a row written
        before the backfill. It is populated only for pre-migration and
        adopted rows — new signups leave it NULL (ADR-0047)."""
        with self.lock:
            rows = self.db.execute(
                "SELECT peer FROM peers WHERE account_id=? AND status='active'",
                (account["id"],)).fetchall()
        if rows:
            return [row["peer"] for row in rows]
        return [account["peer"]] if account["peer"] else []

    def _account_for_peer(self, peer):
        """The account a device peer belongs to, via the relation — falling
        back to the legacy column for a pre-migration shape."""
        with self.lock:
            row = self.db.execute(
                "SELECT a.* FROM accounts a JOIN peers p ON p.account_id=a.id "
                "WHERE p.peer=?", (peer,)).fetchone()
            if row:
                return row
            return self.db.execute(
                "SELECT * FROM accounts WHERE peer=?", (peer,)).fetchone()

    def _account_for_body(self, body):
        """The account an admin request addresses: by a device peer name, or
        by the account token. A device-less account (ADR-0047) has no peer to
        name, so the token is the operator's handle on it; peer addressing
        keeps working for every account that has devices."""
        peer = body.get("peer")
        if peer:
            return self._account_for_peer(peer)
        token = body.get("token")
        if token:
            with self.lock:
                return self.db.execute(
                    "SELECT * FROM accounts WHERE token=?", (token,)).fetchone()
        return None

    @staticmethod
    def _account_name(account):
        """How a report names an account: its legacy first-device peer when
        it has one, else its label. One definition for the burn record, the
        revoke answer and the sweep log, so the three cannot drift."""
        return account["peer"] or account["label"]

    def _insert_peer(self, account_id, peer, label):
        with self.lock:
            self.db.execute(
                "INSERT INTO peers (account_id, peer, label, created, status) "
                "VALUES (?,?,?,?,?)", (account_id, peer, label, self._now(), "active"))

    # -- signup ---------------------------------------------------------

    def signup(self, body, client_ip="unknown"):
        """An invite code — or, in open mode, nothing — becomes an ACCOUNT,
        never a device (ADR-0047). Devices enrol later, client-driven, through
        `add_device`; centring the flow on the durable account is what defines
        the expired-ticket race out of existence — the client is installed
        before it enrols, and the account re-derives tickets freely.

        No daemon call happens here: account creation is desk-only, so a down
        daemon cannot stop signup. Anonymous signup is bounded per IP and by
        capacity."""
        code = (body.get("code") or "").strip()
        if body.get("name"):
            # The old shape (code + device name) is refused, not silently
            # reinterpreted: the caller is told where the device name lives
            # now. The code is not burned by a refused shape.
            return 400, {"error": "signup creates an account only — a device name "
                                  "belongs to enrolment: create the account, then add "
                                  "a device from your account page (POST /api/devices)"}
        if not code and not self.config.open_signup:
            # An empty field is a missing input, not a bad credential. Saying
            # "unknown invite code" here sent users hunting for a code they
            # never typed (#27); the unknown-code refusal below is a different
            # sentence for a different mistake.
            return 403, {"error": "enter your invite code — this desk is invite-only"}
        if not code:
            limit = self._signup_limit_left(client_ip)
            if limit is not None and limit <= 0:
                return 429, {"error": "too many signups from this address today — "
                                      "come back tomorrow or ask the operator"}
        with self.lock:
            known = (self.db.execute(
                "SELECT used_by, days, bytes, plan FROM codes WHERE code=?", (code,)).fetchone()
                     if code else None)
            if code:
                if known and known["used_by"]:
                    return 403, {"error": "invite code already used"}
                if not known and code not in self.file_codes():
                    return 403, {"error": "unknown invite code — this desk is invite-only"}
            active = self.db.execute(
                "SELECT COUNT(*) FROM accounts WHERE status='active'").fetchone()[0]
            if active >= self.config.max_active_accounts:
                return 503, {"error": "this desk is at capacity — ask the operator"}
            # A code may carry a plan payload (days/bytes/plan); a payload-less
            # code — minted bare, or from the operator's file — means the trial.
            if known and (known["days"] or known["bytes"] or known["plan"]):
                expires = self._expiry_for(known["days"] or self.config.trial_days)
                cap = known["bytes"] or self.config.trial_bytes
                plan = known["plan"] or "trial"
            else:
                expires = self._trial_expiry()
                cap = self.config.trial_bytes if code else self.config.open_trial_bytes
                plan = "trial"
            token = secrets.token_hex(16)
            origin = code if code else "open"
            # peer stays NULL and no peers row is written: the account is not
            # a device. The label carries the id so the operator's listing can
            # tell accounts apart without using the credential as a name.
            # One transaction: the row, its label and the code burn (or the
            # signup count) stand or fall together — a crash part-way must not
            # leave a burned code with no account, or an account whose code is
            # still reusable.
            self.db.execute("BEGIN IMMEDIATE")
            try:
                cursor = self.db.execute(
                    "INSERT INTO accounts "
                    "(peer,label,token,code,plan,created,expires,bytes_cap,status,signup_ip) "
                    "VALUES (NULL,?,?,?,?,?,?,?,?,?)",
                    ("account", token, origin, plan, self._now(), expires, cap, "active",
                     client_ip if client_ip and client_ip != "unknown" else None))
                label = f"account-{cursor.lastrowid}"
                self.db.execute("UPDATE accounts SET label=? WHERE id=?",
                                (label, cursor.lastrowid))
                if not code:
                    self._count_signup(client_ip)
                elif known:
                    self.db.execute("UPDATE codes SET used_by=? WHERE code=?", (label, code))
                else:
                    self.db.execute("INSERT INTO codes (code, created, used_by) VALUES (?,?,?)",
                                    (code, self._now(), label))
                self.db.execute("COMMIT")
            except BaseException:
                self.db.execute("ROLLBACK")
                raise
        return 200, {"token": token, "expires": expires,
                     "plan": plan, "bytes_cap": cap,
                     "install": "curl -fsSL -o /tmp/vallum-install.sh "
                               f"{self.config.install_source}"
                               " && sudo bash /tmp/vallum-install.sh --from-release --install-only",
                     "how": "open /account with your account number and add a device — "
                            "each device gets its own join ticket when it enrols"}

    def _signup_limit_left(self, client_ip):
        """How many anonymous signups this address has left today (None = no limit).

        Read from the database, not from process memory. The memory version reset
        on every restart, which on a public desk with open signup meant restarting
        the service was a free way past the limit.
        """
        limit = self.config.signup_ip_day_limit
        if limit <= 0:
            return None
        with self.lock:
            row = self.db.execute(
                "SELECT count FROM signups WHERE ip=? AND day=?",
                (client_ip, self._today())).fetchone()
        used = row["count"] if row else 0
        return max(0, limit - used)

    def _count_signup(self, client_ip):
        """Record one anonymous signup against its address, durably.

        Upsert rather than read-modify-write: two requests from one address can
        arrive on two threads, and a lost update here is a lost limit.
        """
        with self.lock:
            self.db.execute(
                "INSERT INTO signups (ip, day, count) VALUES (?,?,1) "
                "ON CONFLICT(ip, day) DO UPDATE SET count = count + 1",
                (client_ip, self._today()))

    @staticmethod
    def _today():
        """The throttle's day boundary, in UTC.

        `date.today()` is local, and a desk whose clock crosses midnight in a
        non-UTC zone would reset the limit early or late. UTC is what every other
        timestamp in this service uses.
        """
        return datetime.datetime.now(datetime.timezone.utc).date().isoformat()

    def _next_peer_name(self, label):
        """Peer names share their first eight characters on the kernel's
        interface-name ceiling, so the counter leads: u0001-friend, u0002-friend.
        The counter counts *peers*, not accounts — an account may hold
        several devices."""
        with self.lock:
            next_id = self.db.execute(
                "SELECT COALESCE(MAX(id),0)+1 FROM peers").fetchone()[0]
        return f"u{next_id:04d}-{label[:8]}"[:24]

    @staticmethod
    def _expiry_for(days):
        return (datetime.datetime.now(datetime.timezone.utc)
                + datetime.timedelta(days=days)).date().isoformat()

    def _trial_expiry(self):
        return self._expiry_for(self.config.trial_days)

    # -- devices ----------------------------------------------------------

    def _daemon_peers(self):
        """The set of peer names the daemon actually has, or None when it
        cannot be asked. The source of truth for which devices exist
        (ADR-0047 §1): the desk's `peers` rows are reservations and records,
        not reality — a row whose peer the daemon does not have is a ticket
        nobody redeemed (or a peer removed out from under the desk)."""
        live = self._daemon_liveness()
        return None if live is None else set(live)

    def _release_ghost_reservations(self, account, daemon_peers):
        """Release the account's reservations whose peer the daemon does not
        have AND whose ticket has expired (the row is older than
        `reservation_ttl`). A reservation within the TTL is a live ticket the
        client may still redeem — not a ghost. The peer is absent from the
        daemon, so there is nothing to remove there; the row is aligned to
        reality. Returns the released peer names. A daemon that cannot be
        asked (daemon_peers None) releases nothing: no guess, fail-closed."""
        if daemon_peers is None:
            return []
        cutoff = (datetime.datetime.now(datetime.timezone.utc)
                  - datetime.timedelta(seconds=self.config.reservation_ttl)
                  ).isoformat(timespec="seconds")
        released = []
        with self.lock:
            rows = self.db.execute(
                "SELECT peer, created FROM peers WHERE account_id=? AND status='active'",
                (account["id"],)).fetchall()
            for row in rows:
                # ISO-8601 UTC timestamps compare lexicographically in order.
                if row["peer"] not in daemon_peers and row["created"] <= cutoff:
                    self.db.execute(
                        "UPDATE peers SET status='removed' WHERE peer=?", (row["peer"],))
                    released.append(row["peer"])
        return released

    def _live_device_count(self, account, daemon_peers):
        """The cap count: ghost reservations released, then the remaining
        active rows (the legacy first-device column is the fallback for a
        pre-migration account). With the daemon unreachable this is just the
        row count — conservative, no release."""
        self._release_ghost_reservations(account, daemon_peers)
        with self.lock:
            live = self.db.execute(
                "SELECT COUNT(*) FROM peers WHERE account_id=? AND status='active'",
                (account["id"],)).fetchone()[0]
        if live == 0 and account["peer"]:
            live = 1  # a pre-migration row: the legacy column IS the device
        return live

    def _sweep_ghost_reservations(self, active, daemon_peers):
        """The sweep's share of reconciliation: release unredeemed reservations
        on ACTIVE accounts too (the orphan sweep only visits inactive ones), so
        a ghost does not hold a device slot until the account itself expires."""
        actions = []
        for account in active:
            for peer in self._release_ghost_reservations(account, daemon_peers):
                actions.append({"peer": peer, "reason": "unredeemed"})
        if actions:
            print(f"desk: released {len(actions)} unredeemed reservation(s)")
        return actions

    _PUBLIC_LINE_MAX = 8192  # a tri-hybrid public line is a few KB; this is headroom
    _HEX_DIGITS = frozenset("0123456789abcdefABCDEF")

    @classmethod
    def _canonical_public_line(cls, text):
        """The device's public line in the exact form `vallum pubkey` prints,
        or None when it is not a public line at all.

        The responder pins by comparing the whole line byte-for-byte
        (`decide_invite`), and the client presents the canonical encoding:
        lowercase hex, four-digit suite, no whitespace. So a wrapped paste,
        uppercase hex or a short suite field is normalized here — mirroring
        `keys::decode_public` (which ignores whitespace) plus `encode_public`
        (which is canonical) — or the invite would be minted and then refused
        at join time. Suite *match* and KEM *size* are the server's own
        checks (`validate_public_line`); the desk does not know the suite.
        """
        compact = "".join(text.split())
        if len(compact) > cls._PUBLIC_LINE_MAX:
            return None
        fields = compact.split(":")
        if len(fields) != 4 or fields[0] != "vallum1":
            return None
        suite, kem, signing = fields[1:]
        if not 1 <= len(suite) <= 4 or not set(suite) <= cls._HEX_DIGITS:
            return None

        def is_hex(value):
            return bool(value) and len(value) % 2 == 0 and set(value) <= cls._HEX_DIGITS

        if not is_hex(kem) or (signing != "-" and not is_hex(signing)):
            return None
        return f"vallum1:{int(suite, 16):04x}:{kem.lower()}:{signing.lower()}"

    def add_device(self, body, desk_origin=None):
        """A second (third…) device on an existing account: the bearer token
        authenticates, and the new peer's ticket binds the account's plan —
        same expiry, same shared byte pool. This is also the expired-ticket
        recovery path (#27): a fresh ticket, no invite code needed."""
        token = body.get("token") or ""
        label = (body.get("name") or "").strip()[:40]
        if re.fullmatch(r"[a-z0-9][a-z0-9-]{0,30}", label or "-") is None:
            return 400, {"error": "name must be lowercase letters/digits/hyphens"}
        # The device's own public line, when it presents one (ADR-0047 §3):
        # the invite is then pinned to that key. Absent — the web account
        # page's path — the client generates its key at join time. A bad
        # line is refused before the reservation: it burns no device slot
        # and makes no daemon call. A non-string is the same mistake as a
        # malformed line — a 400 naming the field, not a crash behind a 500.
        raw_key = body.get("public_key")
        if raw_key is not None and not isinstance(raw_key, str):
            return 400, {"error": "public_key must be a string — the device's public "
                                  "line from `vallum pubkey --key <file>`"}
        public_key = (raw_key or "").strip() or None
        if public_key:
            public_key = self._canonical_public_line(public_key)
            if public_key is None:
                return 400, {"error": "public_key must be the device's public line — "
                                      "vallum1:<suite>:<kem>:<signing|->, from "
                                      "`vallum pubkey --key <file>` (generate the key on "
                                      "the device with `vallum keygen --key <file>`)"}
        # The lookup, cap check, and the peers row are one locked step —
        # the row IS the reservation, so a racing request counts it, and a
        # racing read on the shared connection never interleaves. The
        # daemon call stays outside the lock: a subprocess under a mutex
        # serializes the desk, and a failed mint deletes the reservation.
        # The daemon's actual peers are the source of truth for the cap
        # (ADR-0047 §1): fetched once here, then used inside the locked step
        # to release ghost reservations and count live devices.
        daemon_peers = self._daemon_peers()
        with self.lock:
            account = self.db.execute(
                "SELECT * FROM accounts WHERE token=?", (token,)).fetchone()
            if not account:
                return 404, {"error": "unknown account token"}
            if account["status"] != "active":
                return 403, {"error": f"account is {account['status']} — "
                                      "devices can only join an active account"}
            live = self._live_device_count(account, daemon_peers)
            if live >= self.config.device_cap:
                return 429, {"error": "device limit — an account carries at most "
                                      f"{self.config.device_cap} devices; remove one first"}
            peer = self._next_peer_name(label)
            self._insert_peer(account["id"], peer, label)
        try:
            ticket = self.daemon.mint_ticket(peer, public_key=public_key)
        except RuntimeError as error:
            with self.lock:
                self.db.execute("DELETE FROM peers WHERE peer=?", (peer,))
            return 502, {"error": f"the daemon refused the enrolment: {error}"}
        with self.lock:
            still = self.db.execute(
                "SELECT 1 FROM peers WHERE peer=? AND status='active'", (peer,)).fetchone()
        if not still:
            return 409, {"error": "the account was revoked while the ticket was minting"}
        return 200, {"ticket": ticket, "peer": peer, "plan": account["plan"],
                     "expires": account["expires"], "bytes_cap": account["bytes_cap"],
                     "pinned": public_key is not None,
                     "connect": connect_uri(ticket, token, desk_origin)}

    def voucher(self, body):
        """A code's payload applied to an existing account — Mullvad's
        submit-voucher shape. Additive: the code's days extend the expiry
        (from its current value, or today if it already lapsed), its bytes
        grow the shared cap, its label replaces the plan; consumed bytes
        stay consumed. The burn and the apply are one locked step."""
        token = body.get("token") or ""
        code = (body.get("code") or "").strip()
        if not code:
            return 400, {"error": "code is required"}
        with self.lock:
            account = self.db.execute(
                "SELECT * FROM accounts WHERE token=?", (token,)).fetchone()
            if not account:
                return 404, {"error": "unknown account token"}
            if account["status"] != "active":
                return 403, {"error": f"account is {account['status']} — "
                                      "only an active account redeems a code"}
            known = self.db.execute(
                "SELECT used_by, days, bytes, plan FROM codes WHERE code=?",
                (code,)).fetchone()
            if not known:
                if code in self.file_codes():
                    return 400, {"error": "this code carries no plan payload — "
                                          "nothing to grant (it still works for signup)"}
                return 403, {"error": "unknown invite code — this desk is invite-only"}
            if known["used_by"]:
                return 403, {"error": "invite code already used"}
            if not (known["days"] or known["bytes"] or known["plan"]):
                return 400, {"error": "this code carries no plan payload — "
                                      "nothing to grant (it still works for signup)"}
            updates, values = [], []
            if known["days"]:
                # ISO dates compare lexicographically: the later of the two.
                base = max(account["expires"], datetime.date.today().isoformat())
                updates.append("expires=?")
                values.append((datetime.date.fromisoformat(base)
                               + datetime.timedelta(days=known["days"])).isoformat())
            if known["bytes"]:
                updates.append("bytes_cap=bytes_cap+?")
                values.append(known["bytes"])
            if known["plan"]:
                updates.append("plan=?")
                values.append(known["plan"])
            values.append(account["id"])
            self.db.execute(f"UPDATE accounts SET {', '.join(updates)} WHERE id=?",
                            tuple(values))
            # The burn records who consumed the code. A device-less account
            # (ADR-0047) has no peer, so its label stands in — a NULL used_by
            # reads as "unused" and the same code would redeem twice.
            self.db.execute("UPDATE codes SET used_by=? WHERE code=?",
                            (self._account_name(account), code))
            row = self.db.execute(
                "SELECT expires, bytes_cap, plan FROM accounts WHERE id=?",
                (account["id"],)).fetchone()
        return 200, {"peer": self._account_name(account), "applied": code,
                     "expires": row["expires"], "bytes_cap": row["bytes_cap"],
                     "plan": row["plan"]}

    def _daemon_liveness(self):
        """The daemon's liveness map, or None when it cannot be asked.

        One place decides what "cannot be asked" means, so `account()` and
        `funnel()` cannot disagree about it. A daemon that cannot answer must not
        take the account page down: the session list, the quota and the revoke
        button are all still true without it.
        """
        try:
            return self.daemon.liveness()
        except (OSError, RuntimeError, subprocess.SubprocessError):
            return None

    def _daemon_counters(self):
        """The daemon's per-peer counters, or None when it cannot be asked.

        The same two-shape answer as `_daemon_liveness`, and for the same reason:
        a daemon that is down must not turn the account page into a 500. The
        quota figure is the one number on that page that comes from the daemon, so
        it says "unknown" rather than rendering a confident `0.00 GiB` — a zero
        here is a statement that the account has used nothing, which is exactly
        the kind of false sentence the liveness work set out to remove.
        """
        try:
            return self.daemon.counters()
        except (OSError, RuntimeError, subprocess.SubprocessError):
            return None

    def _active_devices(self):
        """Every device the desk believes it has, as `{peer, status}`.

        One definition, used by both `account()` and `funnel()`. A pre-migration
        account carries its device in the `peer` column rather than a `peers`
        row, and the two readers must agree about that or the page and the
        metric describe different databases.

        Caller holds the lock.
        """
        rows = [dict(r) for r in self.db.execute(
            "SELECT a.peer AS peer, p.peer AS device, "
            "       COALESCE(p.status, 'active') AS status "
            "FROM accounts a LEFT JOIN peers p ON p.account_id=a.id "
            "ORDER BY a.id, p.id")]
        devices = []
        seen_accounts = set()
        for row in rows:
            if row["device"]:
                devices.append({"peer": row["device"], "status": row["status"]})
            elif row["peer"] and row["peer"] not in seen_accounts:
                # The legacy shape: the account's own peer column IS its device.
                devices.append({"peer": row["peer"], "status": "active"})
            if row["peer"]:
                seen_accounts.add(row["peer"])
        return devices

    def funnel(self):
        """What the alpha is actually producing: tickets minted versus devices
        that ever handshaked.

        This exists because 14 tickets and 0 handshakes read as a healthy quiet
        system for a day. Every device row was `active`, the desk said so
        cheerfully, and nothing anywhere compared "we handed out a ticket" with
        "a device connected". The conversion number is the whole point of an
        alpha, so it has to be a measurement rather than something someone
        notices by reading labels.

        Counts, not a ratio: a ratio hides its denominator, and "0 of 0" and
        "0 of 14" are very different situations that a single float conflates.
        """
        with self.lock:
            accounts = {}
            for row in self.db.execute(
                    "SELECT status, COUNT(*) AS n FROM accounts GROUP BY status"):
                accounts[row["status"]] = row["n"]
            # Attribution. Without this, fourteen accounts from one machine are
            # fourteen unrelated rows — which is exactly how an entire alpha
            # session of self-testing went unnoticed until someone read the
            # labels. `signup_ip` is NULL for rows that predate v2, so the count
            # of unattributed accounts is reported rather than hidden.
            attribution = {
                "distinct_ips": self.db.execute(
                    "SELECT COUNT(DISTINCT signup_ip) FROM accounts "
                    "WHERE signup_ip IS NOT NULL").fetchone()[0],
                "unattributed": self.db.execute(
                    "SELECT COUNT(*) FROM accounts WHERE signup_ip IS NULL").fetchone()[0],
                "shared_ip_accounts": self.db.execute(
                    "SELECT COALESCE(SUM(n), 0) FROM ("
                    "  SELECT COUNT(*) AS n FROM accounts WHERE signup_ip IS NOT NULL "
                    "  GROUP BY signup_ip HAVING COUNT(*) > 1)").fetchone()[0],
            }
            # Every active device the desk believes it has, including the
            # pre-migration rows whose device is the account's own `peer`
            # column. Sharing this with `account()` is deliberate: a funnel that
            # counted only `peers` rows would report 0 devices on a database
            # where `account()` reports one, and the two numbers are read side
            # by side.
            peers = self._active_devices()
        seen = self._daemon_liveness()
        # The same function the account page uses. A funnel that re-derived the
        # states would be a second definition of the same words, and the page and
        # the metric would drift the first time one of them gained a state.
        states = dict.fromkeys(DEVICE_STATES, 0)
        for described in describe_devices(peers, seen, int(time.time())):
            if described["connection"] is not None:
                states[described["connection"]] += 1
        return {
            "accounts": accounts,
            "attribution": attribution,
            "devices": states,
            "devices_total": sum(states.values()),
            # A device that reached a handshake at some point. `live` is now,
            # `offline` is "it worked and then stopped" — both prove the join
            # path runs end to end, which is the question an alpha asks.
            "handshaked": states["live"] + states["offline"],
            "daemon_answered": seen is not None,
        }

    def account(self, token):
        """The full account view the page and its JSON share: the plan row,
        the shared-pool numbers, and every device with its own status."""
        with self.lock:
            row = self.db.execute(
                "SELECT * FROM accounts WHERE token=?", (token,)).fetchone()
            if not row:
                return 404, {"error": "unknown account token"}
            devices = [dict(r) for r in self.db.execute(
                "SELECT peer, label, status, created FROM peers "
                "WHERE account_id=? ORDER BY id", (row["id"],)).fetchall()]
        if not devices and row["peer"]:
            devices = [{"peer": row["peer"], "label": row["label"],
                        "status": "active", "created": row["created"]}]
        counters = self._daemon_counters()
        live = [d["peer"] for d in devices if d["status"] == "active"]
        # Liveness, not provisioning. `status` above is the *record's* state —
        # "this device was issued a peer and not revoked" — and it was the only
        # thing the page showed. A device that never handshaked therefore read as
        # "active", which is a false statement about the one property the user
        # cares about. The daemon already knows better; ask it.
        #
        # A daemon that cannot answer must not take the account page down: the
        # session list, the quota and the revoke button are all still true
        # without it. So a read failure leaves `connection` at `unknown`, which
        # is a different sentence from `offline`.
        devices = describe_devices(devices, self._daemon_liveness(), int(time.time()))
        return 200, {
            "peer": row["peer"], "label": row["label"], "plan": row["plan"],
            "status": row["status"], "expires": row["expires"],
            "paid_until": row["paid_until"], "bytes_cap": row["bytes_cap"],
            # `None`, not 0, when the daemon cannot be asked: "0 GiB used" about
            # a daemon the desk could not reach is a confident answer to a
            # question nobody answered — the false statement this field's
            # neighbours were rewritten to remove.
            "bytes_used": (None if counters is None
                           else sum(counters.get(peer, 0) for peer in live)),
            # The desk's funnel, for this account: tickets issued against
            # devices that ever joined. Shown beside the count, never as a bare
            # rate — see `funnel()` for why the denominator travels with it.
            "conversion": account_conversion(devices),
            "devices": devices}

    def _device_target(self, body, verb, require_active=False):
        """The (account, peer) a per-device verb addresses, or an error
        answer as the third element. Intake typing lives here once: a JSON
        number/list/dict where a name belongs is a 400 naming the field —
        not a sqlite bind error behind a 500, and not a 404 blaming the
        device for the caller's typing. A falsy peer must not reach the
        ownership comparison: the legacy column is NULL on new-contract
        accounts, and `None != None` is False — the comparison would pass
        and act on nothing.
        """
        token = body.get("token")
        if token is not None and not isinstance(token, str):
            return None, None, (400, {"error": "token must be a string — the account number"})
        peer = body.get("peer")
        if peer is not None and not isinstance(peer, str):
            return None, None, (400, {"error": f"peer must be a string — name the device to {verb}"})
        if not peer:
            return None, None, (400, {"error": f"peer is required — name the device to {verb}"})
        with self.lock:
            account = self.db.execute(
                "SELECT * FROM accounts WHERE token=?", (token or "",)).fetchone()
            if not account:
                return None, None, (404, {"error": "unknown account token"})
            if require_active and account["status"] != "active":
                return None, None, (403, {"error": f"account is {account['status']} — "
                                                   f"devices can only {verb} on an active account"})
            owned = self.db.execute(
                "SELECT 1 FROM peers WHERE account_id=? AND peer=? AND status='active'",
                (account["id"], peer)).fetchone()
        if not owned and peer != account["peer"]:
            return None, None, (404, {"error": "unknown device"})
        return account, peer, None

    def remove_device(self, body):
        """The account owner's per-device revoke: the bearer token must own
        the peer. Same removal-first order as the admin path."""
        account, peer, error = self._device_target(body, "remove")
        if error:
            return error
        try:
            self.daemon.remove(peer)
        except RuntimeError as error:
            if "no peer named" not in str(error):
                return 502, {"error": str(error)}
        with self.lock:
            self.db.execute("UPDATE peers SET status='removed' WHERE peer=?", (peer,))
        return 200, {"removed": peer}

    def rotate_device(self, body):
        """Replace a device's key under its stable name (ADR-0047 §4).

        Rotation is never add_device: no reservation, no cap check, no
        ticket — the slot, the address and the plan are untouched, so the
        device count is preserved even at the cap.
        """
        account, peer, error = self._device_target(body, "rotate", require_active=True)
        if error:
            return error
        # The device's OWN new public line is required: there is no unpinned
        # rotation (custody, ADR-0013 — server-generation is the operator's
        # explicit `--ship-key` opt-in, not this path). Validate before any
        # daemon call; a non-string is the same mistake as a malformed line.
        raw_key = body.get("public_key")
        if raw_key is not None and not isinstance(raw_key, str):
            return 400, {"error": "public_key must be a string — the device's new public "
                                  "line from `vallum pubkey --key <file>`"}
        public_key = (raw_key or "").strip()
        if not public_key:
            return 400, {"error": "public_key is required — generate the new key on the "
                                  "device (`vallum keygen --key <file>`) and present its "
                                  "public line (`vallum pubkey --key <file>`)"}
        public_key = self._canonical_public_line(public_key)
        if public_key is None:
            return 400, {"error": "public_key must be the device's public line — "
                                  "vallum1:<suite>:<kem>:<signing|->, from "
                                  "`vallum pubkey --key <file>`"}
        try:
            report = self.daemon.rotate(peer, public_key)
        except RuntimeError as error:
            return 502, {"error": f"the daemon refused the rotation: {error}"}
        payload = {"rotated": peer, "fingerprint": report["fingerprint"],
                   "applied": report["applied"], "finalized": report["finalized"]}
        if not report["finalized"]:
            # The rotation happened; the old key is still accepted. Name both
            # facts; the recovery is a retry of this same call (the rationale
            # lives in DaemonCli.rotate, the decision in ADR-0047 §4).
            payload["warning"] = ("the old key is still accepted: "
                                  f"{report.get('finalize_error', 'finalize failed')} "
                                  "— retry the rotation to retire it")
        return 200, payload

    @staticmethod
    def _now():
        return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")

    # -- status ---------------------------------------------------------

    def health(self):
        """Can this desk serve? One question, two dependencies.

        A desk process can be up and useless, and neither way shows in a port
        check: sqlite can fail on its own file (a lost or full disk), and the
        daemon it enrols against can be down or unreachable through its 0600
        control socket. `GET /healthz` asks both and answers `503` naming the
        one that failed, so a front (Caddy, a load balancer) or an outside-in
        probe can tell "listening" from "working".

        Unauthenticated on purpose: it is the one route a probe hits, and it
        names no account, no peer and no count — only whether each dependency
        answered.
        """
        checks = {}
        try:
            with self.lock:
                self.db.execute("SELECT 1").fetchone()
            checks["database"] = "ok"
        except sqlite3.Error as error:
            # Unreadable, closed, or a file this build will not open: all of
            # them mean the desk cannot serve, and the error line is what says
            # which. No credential is in it.
            checks["database"] = f"unusable: {error}"
        # The same read every device's connection state comes from, so a desk
        # that passes here can also answer "is this device connected?".
        checks["daemon"] = "ok" if self._daemon_liveness() is not None else "unreachable"
        ok = all(state == "ok" for state in checks.values())
        return (200 if ok else 503), {"ok": ok, "checks": checks}

    def status(self, token):
        with self.lock:
            row = self.db.execute(
                "SELECT * FROM accounts WHERE token=?", (token,)).fetchone()
        if not row:
            return 404, {"error": "unknown account token"}
        peers = self._peers_of(row)
        counters = self._daemon_counters()
        used = None if counters is None else sum(counters.get(peer, 0) for peer in peers)
        return 200, {"peer": peers[0] if peers else row["peer"], "peers": peers,
                     "plan": row["plan"], "status": row["status"],
                     "expires": row["expires"], "bytes_cap": row["bytes_cap"],
                     "bytes_used": used}

    # -- enforcement ----------------------------------------------------

    def sweep_once(self):
        """One enforcement pass: expire and de-quota accounts.

        Returns the actions taken, so an operator can trigger it on demand and
        see what happened.
        """
        actions = []
        today = datetime.date.today().isoformat()
        # Counters absent is not counters zero: when the daemon cannot be asked,
        # quota is not judged this pass — but expiry is, because an expiry needs
        # no daemon. The alternative, letting the exception out, stopped the
        # whole pass: one blink of the daemon deferred every revocation with it.
        counters = self._daemon_counters()
        with self.lock:
            active = self.db.execute(
                "SELECT * FROM accounts WHERE status='active'").fetchall()
        for row in active:
            used = (None if counters is None
                    else sum(counters.get(peer, 0) for peer in self._peers_of(row)))
            reason = self._breach_reason(row, used, today)
            if reason:
                actions.append(self._revoke(row, reason, used))
        actions.extend(self._sweep_orphans())
        actions.extend(self._sweep_ghost_reservations(active, self._daemon_peers()))
        return actions

    def _sweep_orphans(self):
        """Mark removed every peer row whose account is no longer active.

        The sweep only visits active accounts, so a peer row left `active` under
        a revoked or expired account is unreachable for ever: nothing revisits
        it, and the admin listing keeps counting it as a live device. Ten such
        rows accumulated on the reference desk, so `vallum-desk-admin devices`
        reported fourteen active devices against four active accounts.

        The daemon removal is attempted, not assumed: an orphaned row can be a
        peer that is *still live on the server and no longer enforced*, which is
        worse than a stale row. A peer the daemon has never heard of — the normal
        case for a ticket nobody redeemed — is already in the goal state, which
        is why "no peer named" is not a failure here (the same reasoning as
        `_revoke`).

        Returns the actions taken, so a sweep reports what it did.
        """
        with self.lock:
            orphans = [dict(row) for row in self.db.execute(
                "SELECT p.peer AS peer FROM peers p JOIN accounts a ON a.id=p.account_id "
                "WHERE p.status='active' AND a.status!='active' ORDER BY p.id")]
        actions = []
        for orphan in orphans:
            peer = orphan["peer"]
            try:
                self.daemon.remove(peer)
            except RuntimeError as error:
                if "no peer named" not in str(error):
                    # Still live on the daemon and still not enforced: leave the
                    # row active so the next pass tries again, and say so.
                    print(f"desk: could not remove orphan {peer}; will retry: {error}")
                    continue
            with self.lock:
                self.db.execute("UPDATE peers SET status='removed' WHERE peer=?", (peer,))
            actions.append({"peer": peer, "reason": "orphaned"})
        if actions:
            print(f"desk: cleared {len(actions)} orphaned peer row(s)")
        return actions

    @staticmethod
    def _breach_reason(row, used, today):
        # Inclusive: an account whose expiry is today is already expired.
        if row["expires"] <= today:
            return "expired"
        if used is not None and used > row["bytes_cap"]:
            return "overquota"
        return None

    def _revoke(self, account, reason, used):
        """Remove the account's peers first, then mark the account.

        The removal is what makes the revocation real, so a failed removal must
        leave the row active: the sweep only visits active accounts, and a row
        marked revoked while its peer still answers is a live peer that is no
        longer enforced and never retried.
        """
        peers = self._peers_of(account)
        action = {"peer": self._account_name(account), "peers": peers,
                  "reason": reason, "bytes": used}
        failed = []
        for peer in peers:
            try:
                self.daemon.remove(peer)
            except RuntimeError as error:
                if "no peer named" not in str(error):
                    failed.append(peer)
                    print(f"desk: could not remove {peer}; will retry: {error}")
                    continue
                # A peer that was never created — a ticket minted but never
                # redeemed — is already gone: the goal state holds, and leaving
                # the row active would retry a removal that can never succeed.
            with self.lock:
                self.db.execute("UPDATE peers SET status='removed' WHERE peer=?", (peer,))
        if failed:
            action["error"] = f"peers still live: {', '.join(failed)}"
            return action
        with self.lock:
            self.db.execute("UPDATE accounts SET status=? WHERE id=?", (reason, account["id"]))
        print(f"desk: removed {', '.join(peers) or self._account_name(account)} "
              f"({reason}, {used if used is not None else 'usage unknown'} bytes)")
        return action

    def sweep(self):
        """The enforcement loop. Never dies: a failure is logged, not fatal."""
        while True:
            try:
                self.sweep_once()
            except Exception as error:  # noqa: BLE001 - the sweep must not kill the service
                print(f"desk: sweep error: {error}")
            time.sleep(self.config.sweep_secs)

    # -- admin ----------------------------------------------------------

    def admin(self, path, body):
        """Admin endpoints. The token gates the whole group, then a routing
        table picks the handler — a switch on a string that grows with the
        service is the kind of function nobody can extend safely."""
        if not self._is_admin(body):
            return 403, {"error": "bad admin token"}
        handler = self._admin_routes().get(path)
        if not handler:
            return 404, {"error": "no such admin endpoint"}
        return handler(body)

    def _is_admin(self, body):
        given = body.get("admin_token") or ""
        # Constant-time: the token is a secret, and a timing side channel on
        # its comparison is a side channel on the service.
        return secrets.compare_digest(given, self.config.admin_token)

    def _admin_routes(self):
        return {
            "/api/admin/code": self._mint_code,
            "/api/admin/adopt": self._adopt_peer,
            "/api/admin/plan": self._set_plan,
            "/api/admin/revoke": self._revoke_peer,
            "/api/admin/revoke-account": self._revoke_account,
            "/api/admin/reset-token": self._reset_token,
            "/api/admin/peers": self._list_peers,
            "/api/admin/devices": self._list_devices,
            "/api/admin/codes": self._list_codes,
            "/api/admin/sweep": self._run_sweep,
        }

    def _mint_code(self, body):
        """Mint a single-use invite code. The code may carry a plan payload —
        days, a byte cap, a plan label — which a signup presenting the code
        lands instead of the trial defaults."""
        code = secrets.token_hex(8)
        days = body.get("days")
        cap = body.get("bytes")
        plan = body.get("plan")
        with self.lock:
            self.db.execute(
                "INSERT INTO codes (code, created, days, bytes, plan) VALUES (?,?,?,?,?)",
                (code, self._now(), days, cap, plan))
        return 200, {"code": code, "days": days, "bytes": cap, "plan": plan,
                     "note": "hand to one user; consumed on signup"}

    def _adopt_peer(self, body):
        """Register a peer that already exists on the server as an account: an
        operator migrating a live deployment, or a device enrolled before the
        desk was running. The peer is not re-created; it becomes enforceable."""
        peer = body.get("peer")
        if not peer:
            return 400, {"error": "peer is required"}
        if self._account_for_peer(peer):
            return 409, {"error": "that peer is already an account"}
        label = (body.get("label") or peer)[:40]
        token = secrets.token_hex(16)
        expires = self._trial_expiry()
        cap = int(body.get("bytes_cap") or self.config.trial_bytes)
        with self.lock:
            cursor = self.db.execute(
                "INSERT INTO accounts (peer,label,token,code,plan,created,expires,bytes_cap,status) "
                "VALUES (?,?,?,?,?,?,?,?,?)",
                (peer, label, token, "adopted", "trial", self._now(), expires, cap, "active"))
            self._insert_peer(cursor.lastrowid, peer, label)
        return 200, {"peer": peer, "token": token, "expires": expires, "bytes_cap": cap}

    def _set_plan(self, body):
        """A plan is a row: cap, expiry, plan name, or status. A paid tier is
        data, and reinstating a mis-quota'd account is the same change.
        Addressed by peer or by account token (device-less accounts)."""
        account = self._account_for_body(body)
        if not account:
            return 404, {"error": "unknown peer or account token"}
        columns, values = [], []
        for column, key in (("bytes_cap", "bytes_cap"), ("expires", "expires"),
                            ("paid_until", "paid_until"), ("plan", "plan")):
            if key in body:
                columns.append(f"{column}=?")
                values.append(int(body[key]) if key == "bytes_cap" else str(body[key]))
        if "status" in body:
            status = str(body["status"])
            if status not in ACCOUNT_STATUSES:
                return 400, {"error": f"status must be one of {'|'.join(ACCOUNT_STATUSES)}"}
            columns.append("status=?")
            values.append(status)
        if not columns:
            return 400, {"error": "nothing to change"}
        with self.lock:
            self.db.execute(f"UPDATE accounts SET {', '.join(columns)} WHERE id=?",
                            (*values, account["id"]))
        return 200, {"peer": self._account_name(account),
                     "updated": [c.split("=")[0] for c in columns]}

    def _revoke_peer(self, body):
        """Per-device: one peer goes, the account survives — its other
        devices keep their tunnel and its plan keeps running."""
        peer = body.get("peer")
        if not self._account_for_peer(peer):
            return 404, {"error": "unknown peer"}
        try:
            self.daemon.remove(peer)
        except RuntimeError as error:
            if "no peer named" not in str(error):
                return 502, {"error": str(error)}
            # Never created — a ticket minted but never redeemed is already
            # gone; mark the row and move on.
        with self.lock:
            self.db.execute("UPDATE peers SET status='removed' WHERE peer=?", (peer,))
        return 200, {"revoked": peer}

    def _revoke_account(self, body):
        """Per-account: every device goes first, then the account is marked —
        the same removal-first order and retry semantics as the sweep.
        Addressed by peer or by account token (device-less accounts)."""
        account = self._account_for_body(body)
        if not account:
            return 404, {"error": "unknown peer or account token"}
        counters = self._daemon_counters()
        used = (None if counters is None
                else sum(counters.get(p, 0) for p in self._peers_of(account)))
        action = self._revoke(account, "revoked", used)
        if "error" in action:
            return 502, action
        return 200, {"revoked": self._account_name(account),
                     "peers": action["peers"]}

    def _reset_token(self, body):
        """Issue a fresh account number for an account that lost it.

        The number is shown once at signup and there is no self-service
        recovery (ADR-0047 Q3): the operator is the recovery path. The old
        number stops working immediately — it is the bearer credential — while
        the account's devices, plan, quota and expiry are untouched. Addressed
        by peer or by the current account number, like the other admin verbs.
        """
        account = self._account_for_body(body)
        if not account:
            return 404, {"error": "unknown peer or account token"}
        token = secrets.token_hex(16)
        with self.lock:
            self.db.execute("UPDATE accounts SET token=? WHERE id=?",
                            (token, account["id"]))
        return 200, {"account": self._account_name(account),
                     "token": token, "status": account["status"],
                     "note": "shown once — the previous account number no longer works"}

    def _list_peers(self, body):
        with self.lock:
            rows = self.db.execute(
                "SELECT peer,label,token,plan,status,expires,bytes_cap FROM accounts").fetchall()
        return 200, {"peers": [dict(row) for row in rows]}

    def _list_devices(self, body):
        with self.lock:
            rows = self.db.execute(
                "SELECT p.peer, p.label AS device, p.status, p.created, "
                "a.label AS account, a.plan AS account_plan, a.signup_ip "
                "FROM peers p JOIN accounts a ON a.id=p.account_id ORDER BY p.id").fetchall()
        return 200, {"devices": [dict(row) for row in rows]}

    def _list_codes(self, body):
        with self.lock:
            rows = self.db.execute(
                "SELECT code, created, used_by, days, bytes, plan "
                "FROM codes ORDER BY created").fetchall()
        return 200, {"codes": [dict(row) for row in rows]}

    def _run_sweep(self, body):
        return 200, {"actions": self.sweep_once()}


# ---------------------------------------------------------------- liveness

# The complete vocabulary. Six words, and every one of them is a different
# situation with a different fix — which is why they are enumerated here rather
# than assembled wherever a caller happens to need one:
#
#   live        connected now, within the protocol's reject window
#   offline     connected at some point, not now
#   never       the peer exists on the server and has never handshaked
#   unredeemed  the desk issued a ticket and no peer was ever created
#   unknown     the daemon could not be asked, so nothing is known
#   (None)      the device is revoked; there is no peer to ask about
#
# This list is the single place the set is defined. A state that is not here
# does not exist, and a state added here gets a sentence from
# `_SENTENCE` below — the two are read together, which is the point.
DEVICE_STATES = ("live", "offline", "never", "unredeemed", "unknown")


def _humanize_age(seconds):
    """A duration a user reads at a glance; not a precise interval."""
    if seconds is None:
        return ""
    seconds = int(seconds)
    if seconds < 90:
        return f"{seconds}s"
    if seconds < 5400:
        return f"{seconds // 60}m"
    if seconds < 172800:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


# state → how the account page says it. Every entry is a full sentence because
# "offline" alone invites "how long?" and "live" alone invites "since when?",
# and because the reader of this column is a user deciding what to do next, not
# an operator reading a dashboard.
_SENTENCE = {
    "live": lambda age: f"connected ({_humanize_age(age)} ago)",
    "offline": lambda age: f"not connected (last seen {_humanize_age(age)} ago)",
    "never": lambda _age: "never connected",
    # The normal outcome of a ticket nobody used: invites live 15 minutes, so a
    # user who signs up and wanders off leaves exactly this. The fix is a new
    # ticket, not a retry — the device cannot connect, because the server has
    # nothing to connect it to.
    "unredeemed": lambda _age: "not set up — the ticket expired before the device "
                               "joined; get a new one",
    "unknown": lambda _age: "unknown — the server could not be asked",
    None: lambda _age: "—",
}


def describe_devices(devices, seen, now):
    """Enrich each device with its connection state, age, and the sentence to show.

    This is the one place the six-state vocabulary is applied. It replaced a
    split that cost real bugs: `account()` decided the state and
    `_connection_cell()` separately decided what that state meant, so adding one
    state meant editing two functions and produced a page that called a device
    "never connected" when it was in fact unredeemed — a wrong sentence about
    the right data.

    `seen` is the daemon's answer, and the difference between its two shapes is
    load-bearing:

    * a **dict** — the daemon answered; a peer mapped to `None` exists and has
      not handshaked, and a peer *absent* from the dict was never created;
    * **None** — the daemon could not be asked, so nothing is known.

    Collapsing those into one empty dict is how a page tells a user "never
    connected" about a device the server has no record of.

    Returns new dicts rather than mutating: a caller that ignores the result
    cannot half-apply it.
    """
    described = []
    for device in devices:
        state, age = _device_state(device, seen, now)
        described.append({
            **device,
            "connection": state,
            "last_seen_seconds": age,
            "connection_sentence": _SENTENCE[state](age),
        })
    return described


def _device_state(device, seen, now):
    """(state, age_seconds) for one device. The decision half of describe_devices."""
    # A revoked device is not a candidate for a connection: the daemon has no
    # peer to ask about, and "never connected" would be a statement about a
    # device that no longer exists.
    if device.get("status") != "active":
        return None, None
    if seen is None:
        return "unknown", None
    if device.get("peer") not in seen:
        return "unredeemed", None
    last = seen[device["peer"]]
    if last is None:
        return "never", None
    try:
        # Clamped at zero: the daemon's clock and the desk's can disagree, and
        # "-3s ago" is a bug report waiting to happen.
        age = max(0, int(now) - int(last))
    except (TypeError, ValueError):
        return "unknown", None
    # The protocol's own reject window, not a number chosen here: past 180 s the
    # key is not used, so the session is over by construction.
    return ("live" if age <= SESSION_LIVE_SECONDS else "offline"), age


def account_conversion(devices):
    """The alpha's conversion question, asked of one account.

    `funnel()` compares tickets issued with devices that ever handshaked, for
    the whole desk; the same comparison scoped to one account is the version an
    owner can act on — and the version that would have shown the 2026-11-16
    session to the person who created it, instead of reading as fourteen
    healthy-but-quiet `active` rows.

    `offline` counts. It proves the join path ran end to end, and counting only
    `live` would report 0 the moment a user closed a laptop — the opposite of
    the signal. `unredeemed` and `never` do not count.

    `devices_connected` is `None`, not 0, when any device is `unknown`: the
    daemon could not be asked, and "0 of 2 have connected" would be a claim the
    desk has no answer for.
    """
    total = len(devices)
    if any(device["connection"] == "unknown" for device in devices):
        return {"devices_total": total, "devices_connected": None}
    return {"devices_total": total,
            "devices_connected": sum(
                1 for device in devices
                if device["connection"] in ("live", "offline"))}


def funnel_exposition(funnel):
    """The funnel as Prometheus text.

    Written here rather than in the pusher because the desk owns the meaning:
    a shell script that recomputed "handshaked" would be a second definition of
    the same word, and the two would drift the first time a state was added.

    Every series is always emitted, including zeros. A metric that appears only
    when it is nonzero makes "no devices" indistinguishable from "the desk did
    not answer", which is the confusion this whole slice exists to remove.
    """
    lines = [
        "# HELP vallum_alpha_devices Devices by connection state, from the daemon's own handshake record.",
        "# TYPE vallum_alpha_devices gauge",
    ]
    for state, count in sorted(funnel["devices"].items()):
        lines.append(f'vallum_alpha_devices{{state="{state}"}} {count}')
    lines += [
        "# HELP vallum_alpha_devices_total Devices the desk is tracking.",
        "# TYPE vallum_alpha_devices_total gauge",
        f'vallum_alpha_devices_total {funnel["devices_total"]}',
        "# HELP vallum_alpha_handshaked_devices Devices that reached a handshake at least once.",
        "# TYPE vallum_alpha_handshaked_devices gauge",
        f'vallum_alpha_handshaked_devices {funnel["handshaked"]}',
        "# HELP vallum_alpha_accounts Accounts by status.",
        "# TYPE vallum_alpha_accounts gauge",
    ]
    for status, count in sorted(funnel["accounts"].items()):
        lines.append(f'vallum_alpha_accounts{{status="{status}"}} {count}')
    lines += [
        "# HELP vallum_alpha_daemon_answered Whether the daemon could be asked about liveness.",
        "# TYPE vallum_alpha_daemon_answered gauge",
        f'vallum_alpha_daemon_answered {1 if funnel["daemon_answered"] else 0}',
        "# HELP vallum_alpha_signup_ips Distinct addresses that created an account.",
        "# TYPE vallum_alpha_signup_ips gauge",
        f'vallum_alpha_signup_ips {funnel["attribution"]["distinct_ips"]}',
        "# HELP vallum_alpha_unattributed_accounts Accounts created before addresses were recorded.",
        "# TYPE vallum_alpha_unattributed_accounts gauge",
        f'vallum_alpha_unattributed_accounts {funnel["attribution"]["unattributed"]}',
        "# HELP vallum_alpha_shared_ip_accounts Accounts whose address also created another account.",
        "# TYPE vallum_alpha_shared_ip_accounts gauge",
        f'vallum_alpha_shared_ip_accounts {funnel["attribution"]["shared_ip_accounts"]}',
    ]
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------- HTTP

def _esc(text):
    return (str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


def install_blurb(install_source=DEFAULT_INSTALL_SOURCE, repo_url=DEFAULT_REPO_URL):
    """The install instructions every enrolment page carries. The source and
    the repo are the operator's: a white-label desk must not send its users
    to the upstream project. The defaults are the upstream values, so an
    unconfigured desk renders exactly what it always did. The link text is
    the repo URL without its scheme — the place a reader recognizes."""
    return f"""<p><b>Don't have the client yet?</b>
<pre>curl -fsSL -o /tmp/vallum-install.sh \\
  {_esc(install_source)}
sudo bash /tmp/vallum-install.sh --from-release --install-only</pre>
Linux + systemd; the release signature verifies itself before anything is
installed. Source and docs: <a href="{_esc(repo_url)}">{_esc(repo_url.split("://", 1)[-1])}</a>.</p>"""


def index_page(open_signup, operator="vallum desk",
               install_source=DEFAULT_INSTALL_SOURCE, repo_url=DEFAULT_REPO_URL):
    code_field = "" if open_signup else (
        '<label>invite code<br><input name="code" required></label><br><br>')
    intro = ("Create an account, then add your devices from your account page; "
             "your key never leaves your machine." if open_signup else
             "An invite code gets you an account; add devices from your account "
             "page — your key never leaves your machine.")
    return f"""<!doctype html><title>{_esc(operator)}</title>
{DESK_STYLE}
<h1>{_esc(operator)}</h1>
<p>Self-service enrolment for this Vallum server. {intro}</p>
{install_blurb(install_source, repo_url)}
<form method="post" action="/signup">
{code_field}
<button>Create my account</button>
</form>
{DESK_FOOTER}"""


def account_created_page(payload, operator="vallum desk",
                         install_source=DEFAULT_INSTALL_SOURCE, repo_url=DEFAULT_REPO_URL):
    """The account-only signup answer (ADR-0047): the account number, shown
    once, and the next step — add a device. No ticket exists yet: each device
    gets its own when it enrols, so nothing on this page expires in fifteen
    minutes. No script, no storage — what the visitor copies is what they keep."""
    token = _esc(payload.get("token", ""))
    expires = _esc(payload.get("expires", ""))
    plan = _esc(payload.get("plan") or "trial")
    gib = payload.get("bytes_cap", 0) // (1024 ** 3)
    manage = (f"""<form method="post" action="/account">
<input type="hidden" name="token" value="{token}">
<button>Manage this account</button></form>"""
              if token else "")
    return f"""<!doctype html><title>your account — {_esc(operator)}</title>
{DESK_STYLE}
<h1>Your account</h1>
<p><small>{_esc(operator)}</small></p>
<p>Shown once. Copy your account number now — the desk does not send it
anywhere else. It is the only credential this account ever has; treat it
like a password.</p>
<p>Plan {plan} until {expires} or {gib} GiB (shared across your devices).</p>
<pre>{token}</pre>
<h2>Next: add a device</h2>
<p>Open your account and use <b>Add a device</b> — each device gets its own
join ticket, minted when the device enrols. Installing the client can come
first; your account outlives any ticket.</p>
<ol>
<li>{install_blurb(install_source, repo_url)}</li>
<li><p>Open your account — <b>Manage this account</b> below, or
<code>/account</code> with your account number — and add your first device.</p></li>
</ol>
{manage}
{DESK_FOOTER}"""


def connect_uri(ticket, token, desk=None):
    """vallum://join?ticket=<t>&account=<token>[&desk=<origin>] — the
    webpage→client bridge. The ticket is URL-encoded; the account token rides
    the URI, never the enrolment wire (ADR-0044). `desk` is the issuing desk's
    origin ('https://' + the Host header the front forwards): the client
    records it as the account's endpoint at join (ADR-0046). Old clients
    ignore the param; a desk with no Host header omits it."""
    from urllib.parse import quote
    uri = f"vallum://join?ticket={quote(ticket, safe='')}&account={token}"
    if desk:
        uri += f"&desk={quote(desk, safe='')}"
    return uri


def ticket_page(payload, operator="vallum desk",
                install_source=DEFAULT_INSTALL_SOURCE, repo_url=DEFAULT_REPO_URL):
    """The one place the ticket is shown. No script, no storage: what the
    visitor copies is what they keep."""
    ticket = _esc(payload.get("ticket", ""))
    peer = _esc(payload.get("peer", ""))
    expires = _esc(payload.get("expires", ""))
    token = _esc(payload.get("token", ""))
    # The plan is a row, not a constant: a payload code lands its own label
    # ("plus"), and the page must say which plan the expiry belongs to (#27).
    plan = _esc(payload.get("plan") or "trial")
    gib = payload.get("bytes_cap", 0) // (1024 ** 3)
    manage = (f"""<form method="post" action="/account">
<input type="hidden" name="token" value="{token}">
<button>Manage this account</button></form>"""
              if token else "")
    connect = ""
    if payload.get("ticket") and token:
        # Fired by script, never an href: a link attribute would leak the
        # token to prefetchers and Referer headers. The payload's connect URI
        # is the one derivation (it carries the desk origin, ADR-0046); the
        # fallback keeps a bare payload renderable.
        uri = payload.get("connect") or connect_uri(payload["ticket"], payload["token"])
        connect = f"""
<p><button id="connect">Connect this device</button></p>
<script>document.getElementById("connect").onclick = function() {{
  window.location = {json.dumps(uri)};
}};</script>"""
    return f"""<!doctype html><title>your join ticket — {_esc(operator)}</title>
{DESK_STYLE}
<h1>Your join ticket</h1>
<p><small>{_esc(operator)}</small></p>
<p>Shown once. Copy it now — the desk does not keep it.
Peer <code>{peer}</code>, {plan} until {expires} or {gib} GiB.</p>
<p><b>This join ticket is valid for {TICKET_TTL_MINUTES} minutes.</b>
Installing the client can come after this page — your account number outlives
the ticket, so a slow install does not lose your account.</p>
<p>If the ticket expires before you join, open your account page —
<b>Manage this account</b> below, or <code>/account</code> with your account
number — and use <b>Add a device</b> to mint a fresh ticket. Your invite code
is already spent and is not needed again.</p>
<pre>{ticket}</pre>
{connect}
<p>Your account number: <code>{token}</code> — the only credential this
account ever has. Save it; the desk does not send it anywhere else.</p>
<ol>
<li>{install_blurb(install_source, repo_url)}</li>
<li><p>Join:</p><pre>sudo vallum join '&lt;ticket&gt;'</pre>
<p>Paste the ticket between the quotes. To keep it out of shell history:
<code>sudo vallum join -</code> reads it from stdin.</p></li>
</ol>
{manage}
{DESK_FOOTER}"""


