def conversion_sentence(conversion):
    """One line for the account page: the count and the rate, together.

    Counts first and the percentage beside them, for the reason `funnel()`
    gives: "0 of 0" and "0 of 1" are different situations that a rate alone
    conflates. The zero sentence also says what to do about it, because 0% on
    this page means one specific thing — the ticket was issued and nothing ever
    joined with it — and the fix is a new join, not patience.
    """
    total = conversion["devices_total"]
    connected = conversion["devices_connected"]
    if total == 0:
        return "no device has been issued a ticket yet, so there is nothing to convert"
    if connected is None:
        return (f"connected: unknown — the server could not be asked "
                f"({total} issued)")
    noun = "device" if total == 1 else "devices"
    verb = "has" if total == 1 else "have"
    rate = round(100 * connected / total)
    sentence = f"{connected} of {total} {noun} {verb} connected ({rate}%)"
    if connected == 0:
        return (sentence + " — the ticket was issued and nothing has joined "
                "with it yet; install the client and open the join link again")
    return sentence


def account_page(view, token, notice="", operator="vallum desk"):
    """The "my account" surface: plan, the shared byte pool, every device —
    and the forms that act on them. The token rides hidden inputs, in POST
    bodies, never the URL."""
    devices = "".join(
        f"<tr><td>{_esc(d['label'])}</td><td><code>{_esc(d['peer'])}</code></td>"
        f"<td>{_esc(d['status'])}</td><td>{_esc(d['connection_sentence'])}</td><td>"
        + (f"""<form method="post" action="/account/revoke" style="display:inline">
<input type="hidden" name="token" value="{_esc(token)}">
<input type="hidden" name="peer" value="{_esc(d['peer'])}">
<button>remove</button></form>""" if d["status"] == "active" else "")
        + "</td></tr>" for d in view["devices"])
    cap_gib = view["bytes_cap"] / (1024 ** 3)
    usage = (f"{view['bytes_used'] / (1024 ** 3):.2f} / {cap_gib:.1f} GiB used "
             "(shared across devices)" if view["bytes_used"] is not None else
             f"usage unknown — the server could not be asked "
             f"({cap_gib:.1f} GiB cap, shared across devices)")
    banner = f"<p><b>{_esc(notice)}</b></p>" if notice else ""
    return f"""<!doctype html><title>{_esc(operator)} — account</title>{ACCOUNT_STYLE}
<p><small>{_esc(operator)}</small></p>
<h1>{_esc(view['label'])}</h1>{banner}
<p>Plan <b>{_esc(view['plan'])}</b> · account {_esc(view['status'])} ·
expires {_esc(view['expires'])} · {usage}.</p>
<h2>Devices</h2>
<p>{_esc(conversion_sentence(view['conversion']))}.</p>
<table><tr><th>name</th><th>peer</th><th>status</th><th>connection</th><th></th></tr>{devices}</table>
<h3>Add a device</h3>
<form method="post" action="/account/device">
<input type="hidden" name="token" value="{_esc(token)}">
<label>device name <input name="name" pattern="[a-z0-9][a-z0-9-]*" required></label>
<button>Get a join ticket</button>
</form>
<h3>Have a code?</h3>
<form method="post" action="/account/voucher">
<input type="hidden" name="token" value="{_esc(token)}">
<label>code <input name="code" required></label>
<button>Apply</button>
</form>
<p><small>Your account number: <code>{_esc(token)}</code> — keep it safe;
it is the only credential.</small></p>
{DESK_FOOTER}"""


def make_handler(desk):
    """The HTTP adapter. It translates requests into desk calls and nothing
    else: no account rule lives here."""

    class Handler(BaseHTTPRequestHandler):
        def _send(self, code, payload):
            body = json.dumps(payload).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            # Every JSON answer here carries a ticket, a token or account data;
            # health carries neither but must not be answered from a cache by a
            # front that would go on saying "ok" after the daemon died.
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _body(self):
            length = int(self.headers.get("Content-Length") or 0)
            raw = self.rfile.read(length) or b""
            if "application/x-www-form-urlencoded" in (self.headers.get("Content-Type") or ""):
                from urllib.parse import parse_qs
                fields = {k: v[0] for k, v in parse_qs(raw.decode(), keep_blank_values=True).items()}
                # curl's `-d` sends form-encoding by default: a JSON body that
                # arrives this way parses as one key with an empty value and
                # then fails with a misleading "bad admin token". Say what it is.
                if len(fields) == 1 and next(iter(fields)).lstrip().startswith("{"):
                    raise ValueError("this looks like a JSON body sent as a form — "
                                     "send it with Content-Type: application/json")
                return fields
            try:
                return json.loads(raw or "{}")
            except json.JSONDecodeError:
                return {}

        def _client_ip(self):
            """The visitor, not the proxy.

            The desk binds loopback and is fronted by Caddy in the documented
            deployment, so every direct peer is the proxy. The rightmost
            X-Forwarded-For hop is the address that proxy saw; a client cannot
            forge it, because the proxy appends its own observation. A direct
            loopback caller could spoof the header, but that caller is already
            inside the operator's trust boundary.
            """
            direct = self.client_address[0]
            forwarded = self.headers.get("X-Forwarded-For")
            if forwarded and direct in ("127.0.0.1", "::1"):
                hop = forwarded.split(",")[-1].strip()
                if hop:
                    return hop
            return direct

        def _desk_origin(self):
            """This desk's public origin: https + the Host header. Caddy (the
            documented front) forwards Host, so the URI tells the client which
            desk its account lives on (ADR-0046). No Host, no desk param —
            never a guess."""
            host = self.headers.get("Host")
            return f"https://{host}" if host else None

        def _send_html(self, body, status=200, private=False):
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            if private:
                # Bearer-authed pages must not be cached or crawled.
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Robots-Tag", "noindex")
            self.end_headers()
            self.wfile.write(body.encode())

        def do_GET(self):
            if self.path == "/healthz":
                # No credential, no account data: the one route a front or a
                # probe can ask, and the answer that separates "listening"
                # from "working".
                code, payload = desk.health()
                self._send(code, payload)
                return
            if self.path == "/":
                self._send_html(index_page(desk.config.open_signup, desk.config.operator_name,
                                           desk.config.install_source, desk.config.repo_url))
                return
            if self.path == "/account":
                self._send_html(account_shell_page(desk.config.operator_name))
                return
            if self.path.startswith("/api/status"):
                # The token used to ride this URL — into proxy access logs.
                # It travels POST bodies now; refuse the old shape.
                self._send(410, {"error": "the token no longer travels the URL — "
                                          "POST it in the body: POST /api/status "
                                          '{"token": "..."}'})
                return
            self._send(404, {"error": "no such endpoint"})

        def do_POST(self):
            try:
                body = self._body()
                if self.path == "/api/signup":
                    code, payload = desk.signup(body, self._client_ip())
                elif self.path == "/signup":
                    # The no-script path: a plain form post, answered with a
                    # page. Agents keep /api/signup and its JSON.
                    code, payload = desk.signup(body, self._client_ip())
                    if code == 200:
                        self._send_html(account_created_page(payload, desk.config.operator_name,
                                                             desk.config.install_source, desk.config.repo_url),
                                        private=True)
                    else:
                        self._send_html(error_page(payload.get("error", ""), desk.config.operator_name),
                                        status=code)
                    return
                elif self.path == "/api/devices":
                    code, payload = desk.add_device(body, self._desk_origin())
                elif self.path == "/api/devices/revoke":
                    code, payload = desk.remove_device(body)
                elif self.path == "/api/devices/rotate":
                    code, payload = desk.rotate_device(body)
                elif self.path == "/api/voucher":
                    code, payload = desk.voucher(body)
                elif self.path == "/api/status":
                    code, payload = desk.status(body.get("token") or "")
                elif self.path == "/api/account":
                    code, payload = desk.account(body.get("token") or "")
                elif self.path == "/account":
                    # The account page, no-script: the token arrives in the
                    # form body, never the URL.
                    code, view = desk.account(body.get("token") or "")
                    if code == 200:
                        self._send_html(account_page(view, body["token"], operator=desk.config.operator_name), private=True)
                    else:
                        self._send_html(error_page(view.get("error", ""), desk.config.operator_name),
                                        status=code, private=True)
                    return
                elif self.path == "/account/device":
                    code, payload = desk.add_device(body, self._desk_origin())
                    if code == 200:
                        # The page needs the token for its manage-account
                        # form; the caller sent it, so this is no new echo.
                        payload["token"] = body.get("token")
                        self._send_html(ticket_page(payload, desk.config.operator_name,
                                                    desk.config.install_source, desk.config.repo_url),
                                        private=True)
                    else:
                        self._send_html(error_page(payload.get("error", ""), desk.config.operator_name),
                                        status=code, private=True)
                    return
                elif self.path == "/account/revoke":
                    code, payload = desk.remove_device(body)
                    notice = (f"removed {payload['removed']}" if code == 200
                              else payload.get("error", "remove failed"))
                    view_code, view = desk.account(body.get("token") or "")
                    if view_code != 200:
                        self._send_html(error_page(view.get("error", ""), desk.config.operator_name),
                                        status=view_code, private=True)
                    else:
                        self._send_html(account_page(view, body.get("token", ""), notice, desk.config.operator_name),
                                        status=code, private=True)
                    return
                elif self.path == "/account/voucher":
                    code, payload = desk.voucher(body)
                    notice = (f"code applied — plan {payload['plan']}, "
                              f"until {payload['expires']}" if code == 200
                              else payload.get("error", "code refused"))
                    view_code, view = desk.account(body.get("token") or "")
                    if view_code != 200:
                        self._send_html(error_page(view.get("error", ""), desk.config.operator_name),
                                        status=view_code, private=True)
                    else:
                        self._send_html(account_page(view, body.get("token", ""), notice, desk.config.operator_name),
                                        status=code, private=True)
                    return
                elif self.path.startswith("/api/admin/"):
                    code, payload = desk.admin(self.path, body)
                else:
                    code, payload = 404, {"error": "no such endpoint"}
            except Exception as error:  # noqa: BLE001 - a service must answer
                # A service must answer, not drop the connection: the client
                # cannot tell a refusal from a crash.
                print(f"desk: request failed: {error!r}")
                code, payload = 500, {"error": f"internal error: {error}"}
            self._send(code, payload)

        def log_message(self, fmt, *args):
            print(f"desk: {self.address_string()} {fmt % args}")

    return Handler


# ---------------------------------------------------------------- main

def parse_args(argv=None):
    parser = argparse.ArgumentParser(description="the Vallum enrolment desk")
    parser.add_argument("--config", required=True, help="the server's vallum config")
    parser.add_argument("--state", default="/var/lib/vallum/desk.sqlite")
    parser.add_argument("--codes", default="/etc/vallum/desk-codes.txt",
                        help="invite codes, one per line")
    parser.add_argument("--admin-token-file", default="/etc/vallum/desk-admin-token")
    parser.add_argument("--bind", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8400)
    parser.add_argument("--trial-days", type=int, default=14)
    parser.add_argument("--trial-bytes", type=int, default=50 * 1024 * 1024 * 1024,
                        help="50 GiB default")
    parser.add_argument("--sweep-secs", type=int, default=300)
    parser.add_argument("--open-signup", action="store_true",
                        help="on-demand access: signup without an invite code")
    parser.add_argument("--open-trial-bytes", type=int, default=5 * 1024 * 1024 * 1024,
                        help="byte cap for anonymous trials (default 5 GiB)")
    parser.add_argument("--max-active-accounts", type=int, default=200,
                        help="capacity ceiling: the peer table is a /24")
    parser.add_argument("--signup-ip-day-limit", type=int, default=3,
                        help="anonymous signups per IP per day (0 = unlimited)")
    parser.add_argument("--device-cap", type=int, default=5,
                        help="devices per account (default 5)")
    parser.add_argument("--operator-name", default="vallum desk",
                        help="the service name shown in page headers")
    parser.add_argument("--install-source", default=DEFAULT_INSTALL_SOURCE,
                        help="the install.sh URL the enrolment pages point at")
    parser.add_argument("--repo-url", default=DEFAULT_REPO_URL,
                        help="the source/docs link shown on enrolment pages")
    parser.add_argument("--cli", default="vallum")
    parser.add_argument("--metrics", action="store_true",
                        help="print the funnel as Prometheus text and exit")
    return parser.parse_args(argv)


def admin_token_from(path):
    """The operator's admin token, generated once if it does not exist."""
    if os.path.exists(path):
        with open(path) as f:
            return f.read().strip()
    token = secrets.token_hex(24)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(token + "\n")
    os.chmod(path, 0o600)
    print(f"desk: generated admin token in {path}")
    return token


def main(argv=None):
    args = parse_args(argv)
    config = DeskConfig(
        state=args.state,
        codes=args.codes,
        admin_token=admin_token_from(args.admin_token_file),
        trial_days=args.trial_days,
        trial_bytes=args.trial_bytes,
        sweep_secs=args.sweep_secs,
        config=args.config,
        bind=args.bind,
        port=args.port,
        cli=args.cli,
        open_signup=args.open_signup,
        open_trial_bytes=args.open_trial_bytes,
        max_active_accounts=args.max_active_accounts,
        signup_ip_day_limit=args.signup_ip_day_limit,
        device_cap=args.device_cap,
        operator_name=args.operator_name,
        install_source=args.install_source,
        repo_url=args.repo_url,
    )
    desk = Desk(config, DaemonCli(config.config, config.cli))
    if args.metrics:
        # One scrape, no listener. The pusher runs this on a timer; there is no
        # new port and no new credential, which is the same reasoning
        # `vallum metrics` uses for the daemon.
        print(funnel_exposition(desk.funnel()), end="")
        return 0
    threading.Thread(target=desk.sweep, daemon=True).start()
    server = ThreadingHTTPServer((config.bind, config.port), make_handler(desk))
    print(f"desk: serving on {config.bind}:{config.port} (config {config.config}, "
          f"{len(desk.file_codes())} invite codes, trials {config.trial_days}d/"
          f"{config.trial_bytes}B)")
    server.serve_forever()


if __name__ == "__main__":
    main()
