# ---------------------------------------------------------------- database

SCHEMA_VERSION = 8

# The protocol's own reject window in seconds (`REJECT_AFTER_TIME_MS` on the
# daemon side). Past it the session is dead by construction: a handshake older
# than this means the device is not connected, whatever the config still says.
# The same number is the client's `stale` verdict boundary, so a user reading
# `vallum status` and a user reading the account page are told the same thing.
SESSION_LIVE_SECONDS = 180

# A request body is a small JSON or form document — the largest legitimate
# one (a sealed-ticket add_device) is a few KB. Anything bigger is a memory
# exhaustion attempt; refuse it before reading.
MAX_BODY = 64 * 1024


class BodyTooLarge(Exception):
    """The request's Content-Length exceeds MAX_BODY (or is unparseable)."""


def token_digest(token):
    """How the account number is stored: sha256, same construction as
    recovery_code_hash. The number itself is 128 bits of CSPRNG — a bare
    hash is the right strength, and a stolen database yields digests an
    attacker cannot present. Every lookup hashes the presented number and
    compares digests; the plaintext is returned once at mint/reset and
    never read back."""
    return hashlib.sha256(str(token).encode()).hexdigest()


# How long a /healthz answer stays fresh. The route is unauthenticated on
# purpose, so the checks behind it (a daemon subprocess and a systemctl
# call) must not be payable per request by anyone on the network.
HEALTHZ_TTL = 5.0

# How long a join ticket lives: `INVITE_TTL_SECS = 15 * 60` in
# crates/vallum/src/enroll.rs — "one sitting: enough to walk to the other
# machine". The ticket page says this window out loud (#27): the alpha's
# 14 tickets / 0 handshakes were users who installed first and joined after
# the ticket expired, with their invite code already burned.
TICKET_TTL_MINUTES = 15

SCHEMA = """
CREATE TABLE IF NOT EXISTS accounts (
    id         INTEGER PRIMARY KEY,
    peer       TEXT UNIQUE,             -- legacy first-device name; NULL for an account-only
                                        -- signup (ADR-0047). The relation is `peers`; this column
                                        -- stays populated only for pre-migration and adopted rows.
    label      TEXT NOT NULL,             -- the account's display name
    token      TEXT UNIQUE NOT NULL,      -- sha256 of the account number (v7); status/auth
    code       TEXT NOT NULL,             -- invite code consumed
    plan       TEXT NOT NULL DEFAULT 'trial',
    created    TEXT NOT NULL,
    expires    TEXT NOT NULL,             -- ISO date; trial end / paid_until
    bytes_cap  INTEGER NOT NULL,          -- rolling total across the period
    status     TEXT NOT NULL DEFAULT 'active',  -- active|expired|overquota|revoked
    paid_until TEXT,
    -- The address the signup came from, kept because nothing else identifies a
    -- device: without it, fourteen accounts from one laptop are fourteen
    -- unrelated rows, which is exactly how a whole alpha session went unnoticed.
    signup_ip  TEXT,
    -- Ownership proof for recovery (premortem mode 7): sha256 of a recovery code
    -- shown once at signup. The operator verifies it before re-issuing a lost
    -- account number, so recovery proves ownership rather than trusting a claimed
    -- label. NULL for accounts created before the code existed.
    recovery_code_hash TEXT,
    -- The device-slot allowance a voucher granted (v8). NULL means the desk's
    -- own default, so a code can sell slots to one account without changing
    -- the shape of everyone else's.
    device_cap INTEGER
);
CREATE TABLE IF NOT EXISTS peers (
    id         INTEGER PRIMARY KEY,
    account_id INTEGER NOT NULL REFERENCES accounts(id),
    peer       TEXT UNIQUE NOT NULL,      -- daemon peer name (u0001 style)
    label      TEXT NOT NULL,             -- the device name the user chose
    created    TEXT NOT NULL,
    status     TEXT NOT NULL DEFAULT 'active'   -- active|removed
);
-- The anonymous-signup throttle, persisted.
--
-- It used to be a Python dict (`self.signups_today`), which meant every restart
-- reset the limit to zero: on a public desk with open signup, restarting the
-- service was a free way to mint unlimited trials. A limit that lives in the
-- process is a limit the operator can accidentally disable.
