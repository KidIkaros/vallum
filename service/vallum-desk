def _connection_cell(device):
    """The one column the user reads to answer "is it working?".

    Rendered as a sentence rather than a flag because "offline" alone invites the
    question "how long?", and "live" alone invites "since when?". A device that
    has never been used says so — that is a different problem from one that
    stopped, and it sends the reader to a different fix.
    """
    state = device.get("connection")
    age = device.get("last_seen_seconds")
    when = humanize_age(age)
    if state == "live":
        return f"connected ({when} ago)"
    if state == "offline":
        return f"not connected (last seen {when} ago)"
    if state == "never":
        return "never connected"
    if state is None:
        return "—"
    return "unknown — the server could not be asked"


