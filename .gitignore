/target
**/target/
*.rpm
*.deb

# Runtime state and secrets
*.pid
*.sock
*.log
*.vallum-bundle
# Private key files: the seed inside is the whole identity.
*.key

# Editor and OS droppings
.DS_Store
.idea/
.vscode/
__pycache__/

# Agent tooling installed per machine (skills and their lockfile). Nothing
# here is needed to build, test or run vallum.
/.agents/
/.claude/
/skills-lock.json

# release artifacts
/dist/
# staged static site (scripts/stage-site.sh)
/site/dist/

# Generated by scripts/gen-completions.sh from the binary — not source.
/packaging/vallum.bash
/packaging/vallum.zsh
/packaging/vallum.fish

# gate verdicts are local evidence, regenerated per run
.vallum-verdicts/
