[Unit]
Description=Vallum exit notice (this host is an exit, not a website)
Documentation=man:vallum(8)
# MOOR's mandatory exit notice, adopted: an exit relay serves an HTTP notice
# explaining it is infrastructure. Same exposure applies to a Vallum server
# carrying full-tunnel clients — this is the safe-harbour posture.
After=network-online.target
Wants=network-online.target
Conflicts=caddy.service nginx.service apache2.service
ConditionPathIsDirectory=/usr/share/vallum/exit-notice

[Service]
Type=simple
# python3's static server: one dependency every server image already has, and
# a page that changes about never. Binds :80, so it runs as root; the sandbox
# is what keeps that honest.
ExecStart=/usr/bin/python3 -m http.server 80 --bind 0.0.0.0 --directory /usr/share/vallum/exit-notice
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/usr/share/vallum/exit-notice
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
