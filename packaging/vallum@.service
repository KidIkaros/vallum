[Unit]
Description=Vallum tunnel %i
Documentation=man:vallum(8) man:vallum.toml(5)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/vallum run --config /etc/vallum/%i.toml
Restart=on-failure
RestartSec=2s
WatchdogSec=30s

# The daemon needs the interface and socket, then drops to `interface.user`.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# The control socket's directory. Created and owned by the service, so a
# `vallum tui` run by the same user can reach it without a manual `install -d`.
RuntimeDirectory=vallum
RuntimeDirectoryMode=0750
ReadWritePaths=/run/vallum

[Install]
WantedBy=multi-user.target
