[Unit]
Description=Vallum tunnel %i
Documentation=man:vallum(8) man:vallum.toml(5)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/vallum run --config /etc/vallum/%i.toml
Restart=on-failure
RestartSec=2s
WatchdogSec=30s

# The daemon needs the interface and socket, then drops to `interface.user`.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# The control socket's directory is created by tmpfiles.d
# (/usr/lib/tmpfiles.d/vallum-tmpfiles.conf), not by this service. It is shared
# by every daemon on the machine, so it must not be a RuntimeDirectory: systemd
# deletes those when a unit stops, which would take every other daemon's socket
# with it. See ADR-0017. This unit only needs write access to it.
ReadWritePaths=/run/vallum

[Install]
WantedBy=multi-user.target
