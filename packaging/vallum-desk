#!/usr/bin/env python3
"""vallum-desk — the self-service enrolment desk for a Vallum server.

One process on the server, next to the daemon. Anyone running a Vallum
server can point would-be users at it: a visitor signs up with an invite
code (closed alpha) or opens a paid plan later, receives a join ticket
minted by the daemon itself, and manages their lane from there. The
operator never runs an SSH command per user.

    vallum-desk --config /etc/vallum/vallumrc.toml \
                --codes /etc/vallum/desk-codes.txt \
                --admin-token-file /etc/vallum/desk-admin-token \
                --bind 127.0.0.1 --port 8400

Binds loopback by default — put a TLS reverse proxy or an SSH tunnel in
front before exposing it. Runs as root because the daemon's control
socket is 0600 and peer operations are privileged; it speaks to the
daemon only through the `vallum` CLI, never by touching the config.

Plans (v1): trial with expiry and a byte cap, enforced by a sweep thread
that reads the daemon's per-peer counters. Payment integration attaches
at the plan boundary — the schema keeps a `paid_until` and `plan` field
so a billing webhook only ever updates a row.

SPDX-License-Identifier: Apache-2.0
"""

import argparse
import datetime
import json
import os
import re
import secrets
import sqlite3
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# ---------------------------------------------------------------- database

SCHEMA = """
CREATE TABLE IF NOT EXISTS accounts (
    id         INTEGER PRIMARY KEY,
    peer       TEXT UNIQUE NOT NULL,      -- daemon peer name (u0001 style)
    label      TEXT NOT NULL,             -- the name the user chose
    token      TEXT UNIQUE NOT NULL,      -- account token: status/auth
    code       TEXT NOT NULL,             -- invite code consumed
    plan       TEXT NOT NULL DEFAULT 'trial',
    created    TEXT NOT NULL,
    expires    TEXT NOT NULL,             -- ISO date; trial end / paid_until
    bytes_cap  INTEGER NOT NULL,          -- rolling total across the period
    status     TEXT NOT NULL DEFAULT 'active',  -- active|expired|overquota|revoked
    paid_until TEXT
);
CREATE TABLE IF NOT EXISTS codes (
    code     TEXT PRIMARY KEY,
    created  TEXT NOT NULL,
    used_by  TEXT                       -- peer name once consumed
);
"""

def db(path):
    # Autocommit (isolation_level=None): every statement commits on its own, so
    # a code minted on one request thread is visible to the next one. With the
    # default deferred transactions, an INSERT left open by one thread made the
    # next request's SELECT miss a row that was plainly in the file.
    conn = sqlite3.connect(path, check_same_thread=False, isolation_level=None)
    conn.row_factory = sqlite3.Row
    conn.executescript(SCHEMA)
    return conn

# ---------------------------------------------------------------- daemon CLI

class Vallum:
    """The only way the desk touches the daemon: the `vallum` CLI."""

    # The ticket is one long token: exclude whitespace, or the CLI's trailing
    # newlines come along and the client hands the daemon a broken ticket.
    TICKET_RE = re.compile(r"vallum1-join:[^\s<]{40,}")

    def __init__(self, config, cli="vallum"):
        self.config, self.cli = config, cli

    def _run(self, *args):
        out = subprocess.run([self.cli, *args, "--config", self.config],
                             capture_output=True, text=True, timeout=60)
        if out.returncode != 0:
            raise RuntimeError(f"vallum {' '.join(args[:2])}: {out.stderr.strip()[:200]}")
        return out.stdout

    def mint_ticket(self, peer):
        out = self._run("peer", "invite", peer)
        m = self.TICKET_RE.search(out)
        if not m:
            raise RuntimeError("invite produced no join ticket — refusing to hand out a placeholder")
        return m.group(0)

    def counters(self):
        """peer → (tx_bytes, rx_bytes) from the daemon's published snapshot."""
        out = self._run("show")
        peers, current, tx = {}, None, 0
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("peer "):
                current = line.split()[1]
            m = re.match(r"(tx_bytes|rx_bytes)=(\d+)", line)
            if m and current:
                if m.group(1) == "tx_bytes":
                    tx = int(m.group(2))
                else:
                    peers[current] = peers.get(current, (0, 0))
                    peers[current] = (tx, int(m.group(2)))
        return peers

    def remove(self, peer):
        self._run("peer", "remove", peer)

# ---------------------------------------------------------------- desk

class Desk:
    def __init__(self, args):
        self.args = args
        self.db = db(args.state)
        self.vallum = Vallum(args.config)
        self.lock = threading.Lock()

    def file_codes(self):
        """Invite codes from the operator's file, re-read per request so a code
        can be added without restarting the desk."""
        path = self.args.codes
        if not path or not os.path.exists(path):
            return set()
        try:
            return {c.strip() for c in open(path) if c.strip() and not c.startswith("#")}
        except OSError:
            return set()

    # -- signup ---------------------------------------------------------

    def signup(self, body):
        code = (body.get("code") or "").strip()
        label = (body.get("name") or "").strip()[:40]
        if not code:
            return 403, {"error": "unknown invite code — this desk is invite-only"}
        if re.fullmatch(r"[a-z0-9][a-z0-9-]{0,30}", label or "-") is None:
            return 400, {"error": "name must be lowercase letters/digits/hyphens"}
        with self.lock:
            dbcode = self.db.execute("SELECT used_by FROM codes WHERE code=?", (code,)).fetchone()
            if dbcode and dbcode["used_by"]:
                return 403, {"error": "invite code already used"}
            if not dbcode and code not in self.file_codes():
                return 403, {"error": "unknown invite code — this desk is invite-only"}
            peer_id = (self.db.execute("SELECT COALESCE(MAX(id),0)+1 FROM accounts").fetchone()[0])
            peer = f"u{peer_id:04d}-{label[:8]}"[:24]
            try:
                ticket = self.vallum.mint_ticket(peer)
            except RuntimeError as e:
                return 502, {"error": f"the daemon refused the enrolment: {e}"}
            now = datetime.datetime.utcnow()
            expires = (now + datetime.timedelta(days=self.args.trial_days)).date().isoformat()
            token = secrets.token_hex(16)
            self.db.execute(
                "INSERT INTO accounts (peer,label,token,code,plan,created,expires,bytes_cap,status) "
                "VALUES (?,?,?,?,?,?,?,?,?)",
                (peer, label, token, code, "trial", now.isoformat(timespec="seconds"),
                 expires, self.args.trial_bytes, "active"))
            self.db.execute("UPDATE codes SET used_by=? WHERE code=?", (peer, code))
            if not dbcode:
                self.db.execute("INSERT INTO codes (code, created, used_by) VALUES (?,?,?)",
                                (code, now.isoformat(timespec="seconds"), peer))
            self.db.commit()
        return 200, {"ticket": ticket, "peer": peer, "token": token,
                     "expires": expires, "bytes_cap": self.args.trial_bytes,
                     "how": "vallum join '<ticket>'  then  vallum-fox adopt"}

    def status(self, token):
        row = self.db.execute("SELECT * FROM accounts WHERE token=?", (token,)).fetchone()
        if not row:
            return 404, {"error": "unknown account token"}
        counters = self.vallum.counters().get(row["peer"], (0, 0))
        return 200, {"peer": row["peer"], "plan": row["plan"], "status": row["status"],
                     "expires": row["expires"], "bytes_cap": row["bytes_cap"],
                     "bytes_used": counters[0] + counters[1]}

    # -- enforcement sweep ----------------------------------------------

    def sweep_once(self):
        """One enforcement pass: expire and de-quota accounts. Returns the
        actions taken, so an operator can trigger it on demand."""
        actions = []
        today = datetime.date.today().isoformat()
        counters = self.vallum.counters()
        for row in self.db.execute("SELECT * FROM accounts WHERE status='active'").fetchall():
            used = sum(counters.get(row["peer"], (0, 0)))
            reason = None
            # Inclusive: an account whose expiry is today is already expired.
            if row["expires"] <= today:
                reason = "expired"
            elif used > row["bytes_cap"]:
                reason = "overquota"
            if reason:
                with self.lock:
                    self.db.execute("UPDATE accounts SET status=? WHERE peer=?",
                                    (reason, row["peer"]))
                try:
                    self.vallum.remove(row["peer"])
                    actions.append({"peer": row["peer"], "reason": reason, "bytes": used})
                    print(f"desk: removed {row['peer']} ({reason}, {used} bytes)")
                except RuntimeError as e:
                    actions.append({"peer": row["peer"], "reason": reason, "error": str(e)})
                    print(f"desk: could not remove {row['peer']}: {e}")
        return actions

    def sweep(self):
        while True:
            try:
                self.sweep_once()
            except Exception as e:  # the sweep must never kill the service
                print(f"desk: sweep error: {e}")
            time.sleep(self.args.sweep_secs)

    # -- admin ----------------------------------------------------------

    def admin(self, path, body):
        if body.get("admin_token") != self.args.admin_token:
            return 403, {"error": "bad admin token"}
        if path == "/api/admin/peers":
            rows = self.db.execute("SELECT peer,label,plan,status,expires,bytes_cap FROM accounts").fetchall()
            return 200, {"peers": [dict(r) for r in rows]}
        if path == "/api/admin/revoke":
            peer = body.get("peer")
            row = self.db.execute("SELECT peer FROM accounts WHERE peer=?", (peer,)).fetchone()
            if not row:
                return 404, {"error": "unknown peer"}
            self.db.execute("UPDATE accounts SET status='revoked' WHERE peer=?", (peer,))
            self.db.commit()
            try:
                self.vallum.remove(peer)
            except RuntimeError as e:
                return 502, {"error": str(e)}
            return 200, {"revoked": peer}
        if path == "/api/admin/code":
            code = secrets.token_hex(8)
            with self.lock:
                self.db.execute("INSERT OR REPLACE INTO codes (code, created) VALUES (?,?)",
                                (code, datetime.datetime.utcnow().isoformat(timespec="seconds")))
                self.db.commit()
            return 200, {"code": code, "note": "hand to one user; consumed on signup"}
        if path == "/api/admin/plan":
            # The income seam: a plan is a row, so a paid tier is data. Set a
            # cap, an expiry, or mark an account paid — no code change.
            peer = body.get("peer")
            row = self.db.execute("SELECT peer FROM accounts WHERE peer=?", (peer,)).fetchone()
            if not row:
                return 404, {"error": "unknown peer"}
            fields, values = [], []
            if "bytes_cap" in body:
                fields.append("bytes_cap=?"); values.append(int(body["bytes_cap"]))
            if "expires" in body:
                fields.append("expires=?"); values.append(str(body["expires"]))
            if "paid_until" in body:
                fields.append("paid_until=?"); values.append(str(body["paid_until"]))
            if "plan" in body:
                fields.append("plan=?"); values.append(str(body["plan"]))
            if not fields:
                return 400, {"error": "nothing to change"}
            with self.lock:
                self.db.execute(f"UPDATE accounts SET {', '.join(fields)} WHERE peer=?",
                                (*values, peer))
            return 200, {"peer": peer, "updated": [f.split("=")[0] for f in fields]}
        if path == "/api/admin/sweep":
            return 200, {"actions": self.sweep_once()}
        return 404, {"error": "no such admin endpoint"}

# ---------------------------------------------------------------- HTTP

PAGE = """<!doctype html><title>vallum desk</title>
<style>body{font:16px/1.6 system-ui;max-width:32em;margin:10vh auto;padding:0 1em}
input,button{font:inherit;padding:.4em .6em}button{cursor:pointer}</style>
<h1>vallum desk</h1>
<p>Self-service enrolment for this Vallum server. An invite code gets you a
join ticket; your key never leaves your machine.</p>
<form onsubmit="go(event)">
<label>invite code<br><input name=code required></label><br><br>
<label>device name<br><input name=name pattern="[a-z0-9][a-z0-9-]*" required></label><br><br>
<button>Get my join ticket</button>
</form><pre id=out></pre>
<script>
async function go(e){e.preventDefault();const f=new FormData(e.target);
const r=await fetch('/api/signup',{method:'POST',headers:{'Content-Type':'application/json'},
body:JSON.stringify({code:f.get('code'),name:f.get('name')})});
const j=await r.json();out.textContent=r.ok?j.ticket+'\n\n'+j.how:j.error;}
</script>"""

def make_handler(desk):
    class Handler(BaseHTTPRequestHandler):
        def _send(self, code, payload):
            body = json.dumps(payload).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _body(self):
            n = int(self.headers.get("Content-Length") or 0)
            try:
                return json.loads(self.rfile.read(n) or "{}")
            except json.JSONDecodeError:
                return {}

        def do_GET(self):
            if self.path == "/":
                body = PAGE.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            elif self.path.startswith("/api/status?"):
                from urllib.parse import parse_qs, urlparse
                q = parse_qs(urlparse(self.path).query)
                code, payload = desk.status((q.get("token") or [""])[0])
                self._send(code, payload)
            else:
                self._send(404, {"error": "no such endpoint"})

        def do_POST(self):
            body = self._body()
            try:
                if self.path == "/api/signup":
                    code, payload = desk.signup(body)
                elif self.path.startswith("/api/admin/"):
                    code, payload = desk.admin(self.path, body)
                else:
                    code, payload = 404, {"error": "no such endpoint"}
            except Exception as e:
                # A service must answer, not drop the connection: the client
                # cannot tell a refusal from a crash.
                print(f"desk: request failed: {e!r}")
                code, payload = 500, {"error": f"internal error: {e}"}
            self._send(code, payload)

        def log_message(self, fmt, *args):
            print(f"desk: {self.address_string()} {fmt % args}")
    return Handler

def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--config", required=True, help="the server's vallum config")
    ap.add_argument("--state", default="/var/lib/vallum/desk.sqlite")
    ap.add_argument("--codes", default="/etc/vallum/desk-codes.txt", help="invite codes, one per line")
    ap.add_argument("--admin-token-file", default="/etc/vallum/desk-admin-token")
    ap.add_argument("--bind", default="127.0.0.1")
    ap.add_argument("--port", type=int, default=8400)
    ap.add_argument("--trial-days", type=int, default=14)
    ap.add_argument("--trial-bytes", type=int, default=50 * 1024 * 1024 * 1024, help="50 GiB default")
    ap.add_argument("--sweep-secs", type=int, default=300)
    args = ap.parse_args()

    args.admin_token = open(args.admin_token_file).read().strip() \
        if os.path.exists(args.admin_token_file) else secrets.token_hex(24)
    if not os.path.exists(args.admin_token_file):
        os.makedirs(os.path.dirname(args.admin_token_file), exist_ok=True)
        with open(args.admin_token_file, "w") as f:
            f.write(args.admin_token + "\n")
        os.chmod(args.admin_token_file, 0o600)
        print(f"desk: generated admin token in {args.admin_token_file}")

    desk = Desk(args)
    threading.Thread(target=desk.sweep, daemon=True).start()
    server = ThreadingHTTPServer((args.bind, args.port), make_handler(desk))
    print(f"desk: serving on {args.bind}:{args.port} (config {args.config}, "
          f"{len(desk.file_codes())} invite codes, trials {args.trial_days}d/{args.trial_bytes}B)")
    server.serve_forever()

if __name__ == "__main__":
    main()
