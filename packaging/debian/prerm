#!/bin/sh
# Stop and disable every Vallum unit on package removal or deconfiguration.
# Upgrades leave enabled units and vallum-guard@ intact so postinst can
# try-restart running tunnels without dropping fail-closed egress policy.
set -e
case "${1:-remove}" in
    remove|deconfigure)
        if [ -d "${VALLUM_SYSTEMD_DIR:-/run/systemd/system}" ]; then
            systemctl list-units --all --plain --no-legend 'vallum*@*' 2>/dev/null \
                | awk '{print $1}' | sed 's/\.service$//;s/\.timer$//' \
                | while read -r unit; do
                    systemctl disable --now "$unit" 2>/dev/null || true
                done
            systemctl disable --now vallum-metrics.timer 2>/dev/null || true
            systemctl disable --now vallum-metrics.service 2>/dev/null || true
        fi
        ;;
    upgrade|failed-upgrade)
        ;;
esac
exit 0
