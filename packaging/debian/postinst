#!/bin/sh
# Mirror install.sh: reload so the new units resolve, and enable the metrics
# timer only where node_exporter's textfile collector exists — it is opt-in
# telemetry, never a default.
set -e
if [ -d /run/systemd/system ]; then
    # Create the runtime directory now, not at the next boot. The unit binds
    # ReadWritePaths to it, and a missing path is 226/NAMESPACE — so a host that
    # installs the package and starts a unit before rebooting would fail. See
    # ADR-0017.
    #
    # Deliberately not `|| true`: if this file is missing the package is broken,
    # and what that produces is a unit crash-looping every two seconds with an
    # error that names systemd's namespace setup rather than the missing path.
    # Failing here is the cheapest place to catch it.
    if [ ! -f /usr/lib/tmpfiles.d/vallum-tmpfiles.conf ]; then
        echo "vallum: /usr/lib/tmpfiles.d/vallum-tmpfiles.conf is missing from the package" >&2
        echo "vallum: /run/vallum will not exist, and every vallum@ unit will fail to start" >&2
        exit 1
    fi
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/vallum-tmpfiles.conf
    systemctl daemon-reload 2>/dev/null || true
    systemctl try-restart 'vallum@*' 'vallum-quick@*' 'vallum-quick-watch@*' 2>/dev/null || true
    if [ -d /var/lib/node_exporter/textfile_collector ]; then
        systemctl enable --now vallum-metrics.timer 2>/dev/null || true
    fi
    # The desk's account database is the one state in the product that cannot
    # be rebuilt, so its copy timer is enabled rather than offered: the service
    # is conditioned on the database existing, which makes it inert on a host
    # that does not run a desk.
    systemctl enable --now vallum-desk-backup.timer 2>/dev/null || true
    # The console's privileged path (its kill switch and its apply) needs a
    # sudoers rule, and a package cannot write one: the rule names a user and
    # the package does not know who is installing it. The installer renders it
    # with the invoking user; here the operator is told the exact line. The
    # console falls back to polkit without it, so this is a convenience, not
    # a requirement.
    if [ ! -f /etc/sudoers.d/vallum-ops ] && [ -x /usr/local/sbin/vallum-ops ]; then
        echo "vallum: to let the console run its privileged path without a password:" >&2
        echo "    echo 'YOUR_USER ALL=(root) NOPASSWD: /usr/local/sbin/vallum-ops' \\"
        echo "      | sudo tee /etc/sudoers.d/vallum-ops >/dev/null" >&2
        echo "    sudo visudo -cf /etc/sudoers.d/vallum-ops" >&2
    fi
fi
exit 0
