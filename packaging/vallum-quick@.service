[Unit]
Description=Vallum host networking for %i (routes, DNS, hooks)
Documentation=man:vallum-quick(8) man:vallum.toml(5)
Requires=vallum@%i.service
After=vallum@%i.service
PartOf=vallum@%i.service

[Service]
# One shot: apply the config's routes, DNS and hooks once the daemon owns the
# interface, then stay "active" so `systemctl stop` runs the reverse. Keeping
# this out of the daemon's unit preserves the daemon's sandbox, which cannot
# write /etc/resolv.conf or run operator hooks.
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/vallum-quick attach /etc/vallum/%i.toml
ExecStop=/usr/bin/vallum-quick detach /etc/vallum/%i.toml
TimeoutStartSec=60s

# CAP_DAC_OVERRIDE is not decoration: the daemon publishes its control socket
# 0600 to the tunnel's owner, and the session gate has to read it. Root without
# the capability is just a user the socket does not belong to.
#
# CAP_SYS_ADMIN is required only by `app_class`: creating the member namespace
# is `unshare(CLONE_NEWNET | CLONE_NEWNS)`, which no lesser capability grants.
# A host-tunnel unit never calls it; app_class moves the tunnel device into the
# member namespace (ADR-0023), and without this the holder fails with
# `unshare: Operation not permitted` (found in dogfood, 2026-11-15 — the gates
# exercise app-class under their own root, never under this unit's sandbox).
AmbientCapabilities=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_SYS_ADMIN
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
