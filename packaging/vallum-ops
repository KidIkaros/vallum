#!/usr/bin/env bash
# vallum-ops: the operator shim for Vallum host networking.
#
# Installed root-owned at /usr/local/sbin/vallum-ops and allowed once in
# /etc/sudoers.d/vallum-ops as NOPASSWD. Each subcommand is a named,
# audited operation — the sudoers file grants this dispatcher, not a
# wildcard, so `vallum-ops -h` lists everything root can be asked to do.
#
#   vallum-ops full-tunnel   # the phase-3 trial (drift check, 90s revert timer)
#   vallum-ops revert        # panic, restore split config, restart unit
#   vallum-ops status        # units, route, handshake, resolver, public IP
#   vallum-ops journal [N]   # last N lines from the vallum units' journals
set -uo pipefail

# LIB is where install.sh ships the deploy scripts; REPO exists only on a dev
# machine (self-update) and is meaningless elsewhere. There is deliberately no
# baked-in default: a path compiled into a root-installed dispatcher is wrong on
# every host but the one it was built on, and it was a password-less root
# escalation for whoever owned that checkout (review, 2026-11-11).
LIB=${VALLUM_LIB:-/usr/local/lib/vallum}
REPO=${VALLUM_REPO:-}
CONF=/etc/vallum/vallum0.toml
IFACE=vallum0
UNIT=vallum@$IFACE

# A verb that installs from a working tree must not exec code from a directory
# its owner can rewrite: under a NOPASSWD sudoers rule that is password-less
# root for that user (ADR-0029). Root-owned sources pass; a single-user dev host
# opts in explicitly with a marker only root can create.
require_trusted_source() {
    if [ -z "$REPO" ]; then
        echo "vallum-ops: VALLUM_REPO is not set — this verb needs a source tree." >&2
        echo "  Install with scripts/install.sh as root, or set VALLUM_REPO." >&2
        exit 1
    fi
    if [ -e /etc/vallum/allow-untrusted-source ]; then
        echo "vallum-ops: WARNING: /etc/vallum/allow-untrusted-source is present;" >&2
        echo "  installing from $REPO without checking who owns it." >&2
        return 0
    fi
    owner=$(stat -c %u "$REPO" 2>/dev/null || echo 1)
    if [ "$owner" != 0 ]; then
        echo "vallum-ops: refusing to install from $REPO: it is owned by uid $owner, not root." >&2
        echo "  Anyone who can write that tree gets root here. Install with scripts/install.sh" >&2
        echo "  as root, or, on a single-user development host only, create" >&2
        echo "  /etc/vallum/allow-untrusted-source (root-owned) to accept the risk." >&2
        exit 1
    fi
}

case "${1:-}" in
full-tunnel)
    exec bash "$LIB/go-full-tunnel.sh"
    ;;
enable)
    # Boot persistence: the tunnel comes up after every power-up, in the
    # config's current mode (split unless the operator applied the full tunnel).
    # The restore floor (vallum-cleanup) runs before it by unit ordering.
    # Optional second argument names another interface (a second tunnel).
    iface=${2:-$IFACE}
    systemctl enable "vallum@$iface"
    systemctl is-enabled "vallum@$iface"
    ;;
disable)
    # Nothing Vallum starts at boot. quick/guard are session units: an enabled
    # guard installs the egress block before any tunnel exists — the outage
    # class this project already paid for once.
    # Optional second argument names another interface, so a leftover unit from
    # a test (`vallum@owtest0`, which failed at every boot) can be retired
    # through this dispatcher rather than a shell that needs a password.
    iface=${2:-$IFACE}
    systemctl disable "vallum@$iface" "vallum-quick@$iface" "vallum-guard@$iface" 2>/dev/null || true
    systemctl reset-failed "vallum@$iface" 2>/dev/null || true
    for u in vallum@$iface vallum-quick@$iface vallum-guard@$iface; do
        if systemctl is-enabled --quiet "$u" 2>/dev/null; then
            printf '  %s: enabled\n' "$u"
        else
            printf '  %s: disabled\n' "$u"
        fi
    done
    ;;
trace)
    # Phase 2's deferred diagnostic: name the openat that the seccomp filter
    # EPERMs under load. Bounded at 60 s, read-only attach, output kept.
    pid=$(systemctl show -p MainPID --value "vallum@$IFACE")
    [ -n "$pid" ] && [ "$pid" != "0" ] || { echo "daemon not running" >&2; exit 1; }
    echo "tracing openat on pid $pid for 60 s under load..."
    # A fixed path in /tmp is a root-owned file an unprivileged user can
    # pre-create as a symlink on a host where it does not exist yet, and
    # `strace -o` truncates whatever it points at (security-redteam.md M5).
    # /run/vallum is root-owned 0770, and mktemp makes the name unpredictable.
    trace_dir=/run/vallum
    [ -d "$trace_dir" ] || trace_dir=/root
    log=$(mktemp "$trace_dir/vallum-openat.XXXXXXXX") || {
        echo "cannot create a trace log in $trace_dir" >&2
        exit 1
    }
    # strace's own stderr goes into the log: a silent tracer that attaches to
    # nothing is worse than no tracer.
    timeout 60 strace -f -p "$pid" -e trace=openat -o "$log" 2>>"$log" &
    tracer=$!
    sleep 2
    # Load: whatever `/etc/vallum/trace-load` names, run as an argv — never a
    # shell string, and never a host, key or port baked into this file. A
    # dispatcher that hardcoded one operator's ssh destination was wrong on
    # every other host and told a reader where that operator's key lives.
    if [ -x /etc/vallum/trace-load ]; then
        load=$(timeout 50 /etc/vallum/trace-load 2>/dev/null | wc -c)
    else
        load=0
        echo "load: none — put a root-owned script at /etc/vallum/trace-load to" >&2
        echo "  push traffic through the tunnel while the trace runs" >&2
    fi
    echo "load: $load bytes through the tunnel"
    wait "$tracer" 2>/dev/null
    total=$(grep -c 'openat(' "$log" 2>/dev/null || echo 0)
    failed=$(grep -cE 'openat\(.*= -1 ' "$log" 2>/dev/null || echo 0)
    echo "openat calls: $total, failed: $failed"
    echo "--- the calls:"
    grep 'openat(' "$log" 2>/dev/null | sed 's/^/  /' | head -20
    echo "--- full log: $log"
    ;;
sync)
    # Deployment automation: make the host match the build under test, then
    # stop. Never runs the cleanup itself — the floor fires at boot only.
    require_trusted_source
    exec bash "$REPO/scripts/vallum-sync.sh"
    ;;
self-update)
    require_trusted_source
    install -m 755 "$REPO/packaging/vallum-ops" /usr/local/sbin/vallum-ops
    echo "dispatcher updated"
    exit 0
    ;;
revert)
    /usr/local/sbin/vallum-panic
    install -m 600 -o root -g root /etc/vallum/vallum0.split.bak "$CONF"
    systemctl reset-failed "$UNIT" 2>/dev/null || true
    systemctl restart "$UNIT"
    sleep 3
    echo "reverted; internet: $(ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && echo ok || echo DOWN)"
    ;;
status)
    echo "unit:      $(systemctl is-active "$UNIT") ($(systemctl is-enabled "$UNIT" 2>&1))"
    echo "guard:     $(systemctl is-active vallum-guard@$IFACE 2>&1)"
    echo "quick:     $(systemctl is-active vallum-quick@$IFACE 2>&1)"
    echo "dead-man:  $(systemctl is-active vallum-deadman@$IFACE.timer 2>&1)"
    echo "route:     $(ip route get 1.1.1.1 2>&1 | head -1)"
    echo "resolver:  $(grep -m1 '^nameserver' /etc/resolv.conf 2>/dev/null || echo none)"
    echo "handshake: $(/usr/bin/vallum show --control /run/vallum/$IFACE.sock 2>/dev/null | grep -m1 last_handshake_time_sec || echo none)"
    # The build the daemon is actually running, so two hosts can be compared
    # without trusting either one's working tree.
    echo "build:     $(/usr/bin/vallum show --control /run/vallum/$IFACE.sock 2>/dev/null | sed -n 's/^ *vallum_build=//p' | head -1 || echo none)"
    # Every enabled tunnel unit needs a config, or boot ends with a failed unit
    # the operator has to interpret. A leftover test unit (vallum@owtest0) did
    # exactly that until 2026-11-11. Enabled instances of a template are the
    # symlinks in the wants directories — `list-unit-files` only knows the
    # template itself. Silent when nothing is wrong.
    for link in /etc/systemd/system/*.wants/vallum@*.service; do
        [ -e "$link" ] || continue
        name=${link##*/vallum@}
        name=${name%.service}
        [ -r "/etc/vallum/$name.toml" ] || \
            echo "boot:      vallum@$name is enabled but /etc/vallum/$name.toml is missing"
    done
    echo "public ip: $(curl -s --max-time 8 https://ifconfig.me 2>/dev/null || echo unknown)"
    ;;
journal)
    journalctl -u "$UNIT" -u "vallum-quick@$IFACE" -u "vallum-guard@$IFACE" \
        --no-pager -o short-iso -n "${2:-40}"
    ;;
*)
    echo "usage: vallum-ops {full-tunnel|revert|status|journal [N]|enable [iface]|disable [iface]|trace|sync|self-update}" >&2
    exit 2
    ;;
esac
