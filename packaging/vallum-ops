#!/usr/bin/env bash
# vallum-ops: the operator shim for Vallum host networking.
#
# Installed root-owned at /usr/local/sbin/vallum-ops and allowed once in
# /etc/sudoers.d/vallum-ops as NOPASSWD. Each subcommand is a named,
# audited operation — the sudoers file grants this dispatcher, not a
# wildcard, so `vallum-ops -h` lists everything root can be asked to do.
#
#   vallum-ops full-tunnel [iface]   # the phase-3 trial (drift check, 90s revert timer)
#   vallum-ops revert [iface]        # panic, restore split config, restart unit
#   vallum-ops join                  # redeem a ticket or vallum://join URI on stdin
#   vallum-ops remove <name>         # reverse join: stop the client, drop config+key
#   vallum-ops setup-remote <u@h>    # SSH enrolment against a remote server
#   vallum-ops setup-server [..]     # initialise this host as a server
#   vallum-ops invite <name> [..]    # mint an invite + start the responder
#   vallum-ops enroll-off [iface]    # close the UDP 51821 enrolment responder
#   vallum-ops status [iface]        # units, route, handshake, resolver, public IP
#   vallum-ops journal [N] [iface]   # last N lines from the vallum units' journals
#   vallum-ops self-update [path]    # install a signed newer copy of this dispatcher
#   vallum-ops update [tag]          # fetch and run the release installer
set -uo pipefail

# LIB is where install.sh ships the deploy scripts; REPO exists only on a dev
# machine (self-update) and is meaningless elsewhere. There is deliberately no
# baked-in default: a path compiled into a root-installed dispatcher is wrong on
# every host but the one it was built on, and it was a password-less root
# escalation for whoever owned that checkout (review, 2026-11-11).
LIB=${VALLUM_LIB:-/usr/local/lib/vallum}
VALLUM_BIN=${VALLUM_BIN:-/usr/bin/vallum}
# The release trust anchor, embedded in this file itself: this script IS the
# signed artefact, so the key that vouches for a candidate cannot be swapped
# by whoever owns the directory it sits in. The same key as
# packaging/vallum-release.pub — release.sh signs SHA256SUMS with it, and a
# `vallum-ops.sig` beside a candidate is what self-update verifies.
OPS_RELEASE_SIGNER='vallum-release ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOcys6KuFRBEnzkhjmC5OvVQDUNCOl39qxrFcQO05dwQ'
# The source tree, if this host has one. `sudo` resets the environment, so the
# path cannot come from VALLUM_REPO alone: it comes from a root-owned pointer
# file that an operator writes once. Nothing is compiled into this file.
REPO=${VALLUM_REPO:-$(cat /etc/vallum/repo 2>/dev/null || true)}
CONF=/etc/vallum/vallum0.toml
IFACE=vallum0

usage() {
    cat >&2 <<'EOF'
vallum-ops — the named, audited privileged operations:

  full-tunnel [iface]     the phase-3 trial (drift check, 90s revert timer)
  revert [iface]          panic, restore split config, restart unit
  join                    redeem a ticket or vallum://join URI on stdin
  remove <name>           reverse join: stop the client, drop config+key
  setup-remote <u@h> [name]   SSH enrolment against a remote server
  setup-server [addr] [listen] [endpoint]   initialise this host as a server
  invite <name> [ttl] [iface] [pinned]      mint an invite + start the responder
  enroll-off [iface]      close the UDP 51821 enrolment responder
  service <start|stop|restart> [iface]
  status [iface]          units, route, handshake, resolver, public IP
  journal [N] [iface]     last N lines from the vallum units' journals
  enable|disable [iface]  boot-start the tunnel unit on or off
  trace [iface]           watch the tunnel's packet path
  sync                    make the host match the build under test
  self-update [path]      install a signed newer copy of this dispatcher
  update [tag]            fetch and run the release installer (vallum, gui, units)
EOF
}

require_iface() {
    case "${1:-}" in
        # A leading dash survives the charset check but lands in argv — a
        # `peer_name` of `--config` would eat the following flag for whoever
        # the verb execs. Names are names, not options.
        ""|*[!A-Za-z0-9._-]*|-*)
            echo "vallum-ops: invalid interface name '${1:-}'" >&2
            exit 2
            ;;
    esac
    if [ "${#1}" -gt 15 ]; then
        echo "vallum-ops: interface name '${1}' exceeds 15 characters" >&2
        exit 2
    fi
}

resolve_conf() {
    local req=${1:-$IFACE}
    if [ -f "/etc/vallum/${req}.toml" ]; then
        printf '/etc/vallum/%s.toml' "$req"
    elif [ -f "/etc/vallum/${req#vallum-}.toml" ]; then
        printf '/etc/vallum/%s.toml' "${req#vallum-}"
    else
        local first
        first=$(ls /etc/vallum/*.toml 2>/dev/null | head -1 || true)
        printf '%s' "${first:-$CONF}"
    fi
}

# The unit stem a name maps to. An explicit name with no config IS the stem —
# stopping or retiring a leftover unit (vallum@owtest0, config deleted) is
# exactly the case where resolve_conf's first-config fallback would aim the
# operation at the live tunnel instead. The default name keeps the fallback.
stem_or_self() {
    local req=$1
    if [ "$req" != "$IFACE" ] \
        && [ ! -f "/etc/vallum/${req}.toml" ] \
        && [ ! -f "/etc/vallum/${req#vallum-}.toml" ]; then
        printf '%s' "$req"
    else
        basename "$(resolve_conf "$req")" .toml
    fi
}

# The config an operation resolves to. Same rule: an explicit wrong name
# refuses rather than falling back onto a tunnel nobody asked for.
conf_or_fail() {
    local req=$1
    if [ "$req" != "$IFACE" ] \
        && [ ! -f "/etc/vallum/${req}.toml" ] \
        && [ ! -f "/etc/vallum/${req#vallum-}.toml" ]; then
        echo "vallum-ops: no config for '$req' in /etc/vallum" >&2
        return 1   # callers run this in $(...) — exit would only kill the subshell
    fi
    resolve_conf "$req"
}

# A verb that installs from a working path must not exec or install code its
# owner can rewrite: under a NOPASSWD sudoers rule that is password-less root
# for that user (ADR-0029). Both the artefact and the directory holding it
# must be root-owned — a root-owned file in a writable directory is one `mv`
# away from anyone's bytes. A single-user dev host opts in explicitly with a
# marker only root can create.
require_trusted_source() {
    local src=$1
    if [ -e /etc/vallum/allow-untrusted-source ]; then
        echo "vallum-ops: WARNING: /etc/vallum/allow-untrusted-source is present;" >&2
        echo "  installing from $src without checking who owns it." >&2
        return 0
    fi
    local owner dir_owner
    owner=$(stat -c %u "$src" 2>/dev/null || echo 1)
    dir_owner=$(stat -c %u "$(dirname -- "$src")" 2>/dev/null || echo 1)
    if [ "$owner" != 0 ] || [ "$dir_owner" != 0 ]; then
        echo "vallum-ops: refusing to install from $src — it or its directory is" >&2
        echo "  not root-owned (uid $owner in dir uid $dir_owner). Anything that can" >&2
        echo "  rewrite those bytes gets root here. Sign the file instead" >&2
        echo "  (vallum-ops.sig beside it), install with scripts/install.sh as root," >&2
        echo "  or, on a single-user development host only, create" >&2
        echo "  /etc/vallum/allow-untrusted-source (root-owned) to accept the risk." >&2
        exit 1
    fi
}

case "${1:-}" in
full-tunnel)
    target_iface=${2:-$IFACE}
    require_iface "$target_iface"
    exec bash "$LIB/go-full-tunnel.sh" "$target_iface"
    ;;
join)
    # Redeem a ticket passed on stdin. Line 1 is the ticket — the raw
    # `vallum1-join:…` string or the desk's `vallum://join?ticket=…` URI,
    # which `vallum join` unwraps itself; an optional line 2 is the desk
    # account token, re-exported as VALLUM_ACCOUNT; an optional line 3 is
    # the desk origin, re-exported as VALLUM_DESK_ENDPOINT. Both ride stdin
    # because the caller's env dies at sudo/pkexec (sudoers grants the
    # dispatcher only, no SETENV), and argv would put the credential in ps.
    # `vallum join` seals them into [account] (ADR-0046, #32) — an env-only
    # endpoint never crossed sudo.
    IFS= read -r join_ticket
    IFS= read -r join_account || join_account=""
    IFS= read -r join_desk || join_desk=""
    if [ -n "$join_desk" ]; then
        case "$join_desk" in
            *[!A-Za-z0-9.:/\[\]_-]*|-*) echo "vallum-ops: invalid desk endpoint '$join_desk'" >&2; exit 2 ;;
        esac
    fi
    if [ -n "$join_account" ] && [ -n "$join_desk" ]; then
        printf '%s\n' "$join_ticket" | VALLUM_ACCOUNT="$join_account" VALLUM_DESK_ENDPOINT="$join_desk" "$VALLUM_BIN" join -
    elif [ -n "$join_account" ]; then
        printf '%s\n' "$join_ticket" | VALLUM_ACCOUNT="$join_account" "$VALLUM_BIN" join -
    else
        printf '%s\n' "$join_ticket" | "$VALLUM_BIN" join -
    fi
    ;;
remove)
    # Reverse `join` for a client this machine enrolled: disable and stop
    # its units, then drop the config + key from /etc/vallum — the out-of-
    # /etc cleanup no unprivileged user can do themselves (`vallum client
    # teardown --purge` needs root for the systemd half). A console's
    # "remove this account" affordance has nothing else to call.
    iface=${2:-}
    require_iface "$iface"
    target_conf=$(conf_or_fail "$iface") || exit 1
    if grep -q '^\[enroll\]' "$target_conf" 2>/dev/null; then
        echo "vallum-ops: '$target_conf' is a server config — remove is for" >&2
        echo "  enrolled clients; a server's teardown is 'vallum server teardown'." >&2
        exit 2
    fi
    exec "$VALLUM_BIN" client teardown --config "$target_conf" --purge
    ;;
setup-remote)
    # Enrol this client over SSH against a remote Vallum server.
    remote=${2:-}
    name=${3:-}
    case "$remote" in
        ""|*[!A-Za-z0-9._@:-]*|-*)
            echo "vallum-ops: invalid SSH target '$remote'" >&2
            exit 2
            ;;
    esac
    # This ssh can never prompt - no tty under sudo/pkexec - so force batch
    # behaviour and a fast failure on unreachable hosts. SSH_ASKPASS/force
    # covers vallum builds that predate VALLUM_SSH_OPTS; the timeout bounds
    # even a connect() that waits out the kernel's full retry window.
    export VALLUM_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10"
    export SSH_ASKPASS=/bin/false SSH_ASKPASS_REQUIRE=force
    if [ -n "$name" ]; then
        require_iface "$name"
        exec timeout 120 /usr/bin/vallum setup --remote "$remote" --name "$name"
    else
        exec timeout 120 /usr/bin/vallum setup --remote "$remote"
    fi
    ;;
setup-server)
    # Initialize this host as a Vallum server.
    addr=${2:-}
    listen=${3:-}
    endpoint=${4:-}
    args=(setup --server)
    if [ -n "$addr" ]; then
        case "$addr" in
            *[!A-Za-z0-9.:,/_-]*|-*) echo "vallum-ops: invalid address '$addr'" >&2; exit 2 ;;
        esac
        args+=(--address "$addr")
    fi
    if [ -n "$listen" ]; then
        case "$listen" in
            *[!A-Za-z0-9.:\[\]_-]*|-*) echo "vallum-ops: invalid listen '$listen'" >&2; exit 2 ;;
        esac
        args+=(--listen "$listen")
    fi
    if [ -n "$endpoint" ]; then
        case "$endpoint" in
            *[!A-Za-z0-9.:\[\]_-]*|-*) echo "vallum-ops: invalid endpoint '$endpoint'" >&2; exit 2 ;;
        esac
        args+=(--endpoint "$endpoint")
    fi
    exec /usr/bin/vallum "${args[@]}"
    ;;
invite)
    # Mint a single-use invite token and start the responder / firewall rule.
    peer_name=${2:-}
    ttl=${3:-60}
    req_iface=${4:-$IFACE}
    pinned=${5:-}
    require_iface "$peer_name"
    require_iface "$req_iface"
    case "$ttl" in
        ""|*[!0-9]*) echo "vallum-ops: invalid TTL '$ttl'" >&2; exit 2 ;;
    esac
    target_conf=$(conf_or_fail "$req_iface") || exit 1
    if [ -n "$pinned" ]; then
        exec /usr/bin/vallum peer invite "$peer_name" --ttl "$ttl" --config "$target_conf" --public-key "$pinned"
    else
        exec /usr/bin/vallum peer invite "$peer_name" --ttl "$ttl" --config "$target_conf"
    fi
    ;;
enroll-off)
    # Close the temporary UDP 51821 enrolment responder and firewall port.
    req_iface=${2:-$IFACE}
    require_iface "$req_iface"
    target_conf=$(conf_or_fail "$req_iface") || exit 1
    exec /usr/bin/vallum server enroll --disable --config "$target_conf"
    ;;
service)
    # Start, stop or restart the tunnel's unit.
    #
    # The console's START and STOP buttons need this. It lives in THIS
    # dispatcher so the sudoers rule keeps granting one binary: a rule for
    # `systemctl start|stop|restart vallum@*` would let its holder pass any
    # arguments to systemctl, which is a much wider grant than the console
    # needs.
    #
    # The second argument is the action, the third names the interface.
    action=${2:-start}
    iface=${3:-$IFACE}
    require_iface "$iface"
    stem=$(stem_or_self "$iface")
    case "$action" in
        start|stop|restart) ;;
        *)
            echo "vallum-ops: unknown service action '$action'" >&2
            exit 2
            ;;
    esac
    if [ "$action" = start ]; then
        # A unit that has been killed a few times refuses to start until its
        # failure counter is cleared, and the console reports a failure it
        # caused.
        systemctl reset-failed "vallum@$stem" 2>/dev/null || true
    fi
    systemctl "$action" "vallum@$stem"
    systemctl is-active "vallum@$stem"
    ;;
enable)
    # Boot persistence: the tunnel comes up after every power-up, in the
    # config's current mode (split unless the operator applied the full tunnel).
    # The restore floor (vallum-cleanup) runs before it by unit ordering.
    # quick/watch are the lifecycle pair the tunnel needs for routes and DNS —
    # they are not pulled in by vallum@, so enable restores exactly the set
    # disable stripped, minus guard/enroll which stay session-scoped on
    # purpose (an enabled guard installs the egress block before any tunnel
    # exists — the outage class this project already paid for once).
    # Optional second argument names another interface (a second tunnel).
    iface=${2:-$IFACE}
    require_iface "$iface"
    # Enabling a stem with no config makes a unit that fails at every boot,
    # so the strict resolution refuses rather than guessing.
    target_conf=$(conf_or_fail "$iface") || exit 1
    stem=$(basename "$target_conf" .toml)
    systemctl enable "vallum@$stem" "vallum-quick@$stem" "vallum-quick-watch@$stem"
    systemctl is-enabled "vallum@$stem"
    ;;
disable)
    # Nothing Vallum starts at boot. quick/guard are session units: an enabled
    # guard installs the egress block before any tunnel exists — the outage
    # class this project already paid for once.
    # Optional second argument names another interface, so a leftover unit from
    # a test (`vallum@owtest0`, which failed at every boot) can be retired
    # through this dispatcher rather than a shell that needs a password.
    iface=${2:-$IFACE}
    require_iface "$iface"
    # A leftover unit is exactly the case resolve_conf's fallback gets wrong:
    # the config is gone, so a verbatim stem is what the name must mean.
    stem=$(stem_or_self "$iface")
    systemctl disable "vallum@$stem" "vallum-quick@$stem" "vallum-guard@$stem" \
        "vallum-quick-watch@$stem" "vallum-enroll@$stem" 2>/dev/null || true
    systemctl reset-failed "vallum@$stem" 2>/dev/null || true
    for u in vallum@$stem vallum-quick@$stem vallum-guard@$stem \
        vallum-quick-watch@$stem vallum-enroll@$stem; do
        if systemctl is-enabled --quiet "$u" 2>/dev/null; then
            printf '  %s: enabled\n' "$u"
        else
            printf '  %s: disabled\n' "$u"
        fi
    done
    ;;
trace)
    # Phase 2's deferred diagnostic: name the openat that the seccomp filter
    # EPERMs under load. Bounded at 60 s, read-only attach, output kept.
    # Optional second argument names another interface's config stem.
    req_iface=${2:-$IFACE}
    require_iface "$req_iface"
    trace_stem=$(stem_or_self "$req_iface")
    pid=$(systemctl show -p MainPID --value "vallum@$trace_stem")
    [ -n "$pid" ] && [ "$pid" != "0" ] || { echo "daemon not running" >&2; exit 1; }
    echo "tracing openat on pid $pid for 60 s under load..."
    # A fixed path in /tmp is a root-owned file an unprivileged user can
    # pre-create as a symlink on a host where it does not exist yet, and
    # `strace -o` truncates whatever it points at (security-redteam.md M5).
    # /run/vallum is root-owned 0770, and mktemp makes the name unpredictable.
    trace_dir=/run/vallum
    [ -d "$trace_dir" ] || trace_dir=/root
    log=$(mktemp "$trace_dir/vallum-openat.XXXXXXXX") || {
        echo "cannot create a trace log in $trace_dir" >&2
        exit 1
    }
    # strace's own stderr goes into the log: a silent tracer that attaches to
    # nothing is worse than no tracer.
    timeout 60 strace -f -p "$pid" -e trace=openat -o "$log" 2>>"$log" &
    tracer=$!
    sleep 2
    # Load: whatever `/etc/vallum/trace-load` names, run as an argv — never a
    # shell string, and never a host, key or port baked into this file. A
    # dispatcher that hardcoded one operator's ssh destination was wrong on
    # every other host and told a reader where that operator's key lives.
    if [ -x /etc/vallum/trace-load ]; then
        load=$(timeout 50 /etc/vallum/trace-load 2>/dev/null | wc -c)
    else
        load=0
        echo "load: none — put a root-owned script at /etc/vallum/trace-load to" >&2
        echo "  push traffic through the tunnel while the trace runs" >&2
    fi
    echo "load: $load bytes through the tunnel"
    wait "$tracer" 2>/dev/null
    total=$(grep -c 'openat(' "$log" 2>/dev/null || echo 0)
    failed=$(grep -cE 'openat\(.*= -1 ' "$log" 2>/dev/null || echo 0)
    echo "openat calls: $total, failed: $failed"
    echo "--- the calls:"
    grep 'openat(' "$log" 2>/dev/null | sed 's/^/  /' | head -20
    echo "--- full log: $log"
    ;;
sync)
    # Deployment automation: make the host match the build under test, then
    # stop. Never runs the cleanup itself — the floor fires at boot only.
    # `--check` reports drift without touching it, so a console can ask
    # "is anything stale?" as a read.
    if [ -z "$REPO" ]; then
        echo "vallum-ops: VALLUM_REPO is not set — sync needs a source tree." >&2
        echo "  Install with scripts/install.sh as root, or set VALLUM_REPO." >&2
        exit 1
    fi
    require_trusted_source "$REPO"
    case "${2:-}" in
        "" | --check) ;;
        *)
            echo "vallum-ops: unknown sync argument '${2:-}'" >&2
            exit 2
            ;;
    esac
    exec bash "$REPO/scripts/vallum-sync.sh" "${2:-}"
    ;;
self-update)
    # Install a newer copy of this dispatcher. The candidate is argv's path,
    # else the repo's packaged file.
    src=${2:-$REPO/packaging/vallum-ops}
    [ -f "$src" ] || { echo "vallum-ops: no dispatcher at '$src'" >&2; exit 1; }
    sig=${src}.sig
    if [ -f "$sig" ]; then
        # A signed artefact proves itself: the release key vouching for these
        # bytes makes the owning uid of the tree irrelevant — the trust model
        # the unsigned path needed root-owned sources for, the signature
        # carries in the file. A sig that does not verify is a refusal, never
        # a fallback to weaker evidence.
        anchor=$(mktemp /run/vallum/ops-signers.XXXXXX 2>/dev/null || mktemp) || exit 1
        printf '%s\n' "$OPS_RELEASE_SIGNER" > "$anchor"
        if ssh-keygen -Y verify -f "$anchor" -n file -I vallum-release \
                -s "$sig" < "$src" 2>/dev/null; then
            rm -f "$anchor"
            install -m 755 "$src" /usr/local/sbin/vallum-ops
            echo "dispatcher updated (release-signed)"
            exit 0
        fi
        rm -f "$anchor"
        echo "vallum-ops: $sig does not verify against the release key — refusing" >&2
        exit 1
    fi
    require_trusted_source "$src"
    install -m 755 "$src" /usr/local/sbin/vallum-ops
    echo "dispatcher updated"
    exit 0
    ;;
update)
    # The product's update path. The dispatcher bootstraps it — install.sh
    # from the release does the real work (signature verify, downgrade
    # refusal, the file map it alone owns). The download rides the same
    # GitHub TLS the original install trusted; nothing here re-derives the
    # installer's logic, so the two can never drift apart.
    command -v curl >/dev/null 2>&1 || {
        echo "vallum-ops: update needs curl" >&2; exit 1; }
    work=$(mktemp -d) || exit 1
    url="https://github.com/KidIkaros/vallum/releases/latest/download/install.sh"
    curl -fsSL -o "$work/install.sh" "$url" || {
        rm -rf "$work"
        echo "vallum-ops: could not fetch the installer ($url)" >&2
        exit 1
    }
    bash "$work/install.sh" --from-release --install-only ${2:+"$2"}
    rc=$?
    rm -rf "$work"
    [ "$rc" -eq 0 ] || exit "$rc"
    # Units keep the build they started with — a surprise restart would drop
    # live tunnels, so the choice stays with whoever owns the machine.
    if systemctl list-units --plain --no-legend 'vallum@*.service' 2>/dev/null \
            | grep -q .; then
        echo "note: running tunnels still run the previous build —" >&2
        echo "  restart when ready: vallum-ops service restart <iface>" >&2
    fi
    exit 0
    ;;
revert)
    req_iface=${2:-$IFACE}
    require_iface "$req_iface"
    target_conf=$(conf_or_fail "$req_iface") || exit 1
    stem=$(basename "$target_conf" .toml)
    target_unit="vallum@$stem"
    /usr/local/sbin/vallum-panic
    if [ -f "/etc/vallum/${stem}.split.bak" ]; then
        install -m 600 -o root -g root "/etc/vallum/${stem}.split.bak" "$target_conf"
    elif [ -f /etc/vallum/vallum0.split.bak ]; then
        install -m 600 -o root -g root /etc/vallum/vallum0.split.bak "$target_conf"
    fi
    systemctl reset-failed "$target_unit" 2>/dev/null || true
    systemctl restart "$target_unit"
    sleep 3
    echo "reverted; internet: $(ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && echo ok || echo DOWN)"
    ;;
status)
    req_iface=${2:-$IFACE}
    require_iface "$req_iface"
    stem=$(stem_or_self "$req_iface")
    # `show --config` resolves the socket itself: the daemon names it for
    # the INTERFACE (`vallum-u0007-do`), which is not the config stem on an
    # enrolled client — a stem-built path silently answered "handshake: none"
    # for a live tunnel.
    target_conf=$(conf_or_fail "$req_iface") || exit 1
    echo "unit:      $(systemctl is-active "vallum@$stem") ($(systemctl is-enabled "vallum@$stem" 2>&1))"
    echo "guard:     $(systemctl is-active "vallum-guard@$stem" 2>&1)"
    echo "quick:     $(systemctl is-active "vallum-quick@$stem" 2>&1)"
    echo "dead-man:  $(systemctl is-active "vallum-deadman@$stem.timer" 2>&1)"
    echo "route:     $(ip route get 1.1.1.1 2>&1 | head -1)"
    # The mode is what the config claims, not whether a .split.bak happens to
    # be lying around: a peer routing 0.0.0.0/0 is the full tunnel regardless
    # of how it got there. Servers carry [enroll]; mode is a client concept.
    if grep -q '^\[enroll\]' "$target_conf"; then
        echo "mode:      server"
    elif grep -q '"0\.0\.0\.0/0"' "$target_conf"; then
        echo "mode:      full-tunnel (0.0.0.0/0 routed)"
    else
        echo "mode:      split"
    fi
    echo "resolver:  $(grep -m1 '^nameserver' /etc/resolv.conf 2>/dev/null || echo none)"
    # Three states, not one "none": the field only exists for a peer with a
    # live session. Absent is split by show's own honesty — with no daemon to
    # ask it prints the configured device plus a "no daemon connected" note.
    # The note rides stderr, so a second call captures it: output alone never
    # proves the daemon answered.
    show_out=$($VALLUM_BIN show --config "$target_conf" 2>/dev/null)
    show_err=$($VALLUM_BIN show --config "$target_conf" 2>&1 >/dev/null)
    hs=$(grep -m1 last_handshake_time_sec <<<"$show_out" || true)
    if [ -n "$hs" ]; then
        hs_state=$hs
    elif [ -z "$show_out" ] || grep -q "no daemon connected" <<<"$show_err"; then
        hs_state="no answer"
    else
        hs_state="no live session"
    fi
    echo "handshake: $hs_state"
    # The build the daemon is actually running, so two hosts can be compared
    # without trusting either one's working tree.
    build=$(sed -n 's/^ *vallum_build=//p' <<<"$show_out" | head -1)
    echo "build:     ${build:-none}"
    # Every enabled tunnel unit needs a config, or boot ends with a failed unit
    # the operator has to interpret. A leftover test unit (vallum@owtest0) did
    # exactly that until 2026-11-11. Enabled instances of a template are the
    # symlinks in the wants directories — `list-unit-files` only knows the
    # template itself. Silent when nothing is wrong.
    for link in /etc/systemd/system/*.wants/vallum@*.service; do
        [ -e "$link" ] || continue
        name=${link##*/vallum@}
        name=${name%.service}
        [ -r "/etc/vallum/$name.toml" ] || \
            echo "boot:      vallum@$name is enabled but /etc/vallum/$name.toml is missing"
    done
    echo "public ip: $(curl -s --max-time 8 https://ifconfig.me 2>/dev/null || echo unknown)"
    # The dev-host opt-out of the source-ownership check is silent everywhere
    # else — status is the one place it should never be invisible.
    [ -e /etc/vallum/allow-untrusted-source ] && \
        echo "trust:     allow-untrusted-source present — unsigned self-updates install"
    ;;
journal)
    lines=${2:-40}
    req_iface=${3:-$IFACE}
    case "$lines" in
        ""|*[!0-9]*) lines=40 ;;
    esac
    require_iface "$req_iface"
    stem=$(basename "$(resolve_conf "$req_iface")" .toml)
    journalctl -u "vallum@$stem" -u "vallum-quick@$stem" -u "vallum-guard@$stem" \
        --no-pager -o short-iso -n "$lines"
    ;;
help|-h|--help)
    usage
    ;;
*)
    if [ -n "${1:-}" ]; then
        echo "vallum-ops: unknown verb '$1'" >&2
    fi
    usage
    exit 2
    ;;
esac
